<%- include('../partials/header') %>

<style>
/* ── Upload Notulensi Page Styles ── */
.um-page { padding: 1.5rem 2rem; max-width: 72rem; margin: 0 auto; display: flex; flex-direction: column; gap: 2rem; }
@media (max-width: 640px) { .um-page { padding: 1rem; } }

/* ── Page Header ── */
.um-header h1 {
  font-size: 2rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1.1;
  background: linear-gradient(135deg, #10b981, #14b8a6);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
}
.um-header p { font-size: 0.875rem; color: var(--muted-foreground); margin-top: 0.5rem; max-width: 36rem; font-weight: 500; }

/* ── Card ── */
.um-card {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 0.75rem; overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.um-card-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--border);
  background: color-mix(in srgb, var(--muted) 30%, transparent);
  display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
}
.um-card-title {
  display: flex; align-items: center; gap: 0.625rem;
  font-size: 0.9375rem; font-weight: 700; color: var(--card-foreground);
}
.um-icon-box {
  width: 2rem; height: 2rem; border-radius: 0.5rem;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.um-icon-emerald { background: color-mix(in srgb, #10b981 15%, transparent); color: #10b981; }
.um-icon-neutral {
  width: 2.25rem; height: 2.25rem; border-radius: 0.625rem;
  background: color-mix(in srgb, var(--muted) 60%, transparent);
  border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  color: var(--muted-foreground);
}

/* ── Form ── */
.um-form-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
.um-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
@media (max-width: 640px) { .um-grid-2 { grid-template-columns: 1fr; } }

.um-field { display: flex; flex-direction: column; gap: 0.375rem; }
.um-label { font-size: 0.8125rem; font-weight: 600; color: var(--card-foreground); }
.um-label .req { color: #ef4444; }
.um-label .opt { color: var(--muted-foreground); font-weight: 500; font-size: 0.75rem; }

.um-select, .um-textarea {
  width: 100%; padding: 0.625rem 0.875rem; border-radius: 0.5rem;
  border: 1.5px solid var(--border); background: var(--background);
  color: var(--foreground); font-size: 0.875rem;
  transition: border-color 0.15s, box-shadow 0.15s; outline: none; font-family: inherit;
}
.um-select:focus, .um-textarea:focus {
  border-color: #10b981;
  box-shadow: 0 0 0 3px color-mix(in srgb, #10b981 20%, transparent);
}
.um-textarea { resize: none; }

/* ── Drop Zone ── */
.um-dropzone {
  position: relative; border: 2px dashed var(--border); border-radius: 1rem;
  padding: 2.5rem 2rem; text-align: center; cursor: pointer;
  transition: all 0.25s; background: transparent;
}
.um-dropzone:hover, .um-dropzone.drag-over {
  border-color: #10b981;
  background: color-mix(in srgb, #10b981 6%, transparent);
  box-shadow: 0 0 24px color-mix(in srgb, #10b981 15%, transparent);
}
.um-dropzone.amber-zone:hover, .um-dropzone.amber-zone.drag-over {
  border-color: #f59e0b;
  background: color-mix(in srgb, #f59e0b 6%, transparent);
}
.um-dropzone.violet-zone:hover, .um-dropzone.violet-zone.drag-over {
  border-color: #8b5cf6;
  background: color-mix(in srgb, #8b5cf6 6%, transparent);
}
.um-drop-icon-wrap {
  width: 3rem; height: 3rem; border-radius: 50%; margin: 0 auto 0.75rem;
  display: flex; align-items: center; justify-content: center;
  background: color-mix(in srgb, var(--muted) 60%, transparent);
  transition: all 0.25s;
}
.um-dropzone:hover .um-drop-icon-wrap { background: color-mix(in srgb, #10b981 15%, transparent); transform: scale(1.1); }
.um-dropzone.amber-zone:hover .um-drop-icon-wrap { background: color-mix(in srgb, #f59e0b 15%, transparent); }
.um-dropzone.violet-zone:hover .um-drop-icon-wrap { background: color-mix(in srgb, #8b5cf6 15%, transparent); }
.um-drop-icon { width: 1.5rem; height: 1.5rem; color: var(--muted-foreground); transition: color 0.2s; }
.um-dropzone:hover .um-drop-icon { color: #10b981; }
.um-dropzone.amber-zone:hover .um-drop-icon { color: #f59e0b; }
.um-dropzone.violet-zone:hover .um-drop-icon { color: #8b5cf6; }

.um-drop-label { font-size: 0.875rem; font-weight: 500; color: var(--card-foreground); }
.um-drop-link { color: #10b981; }
.um-dropzone.amber-zone .um-drop-link { color: #f59e0b; }
.um-dropzone.violet-zone .um-drop-link { color: #8b5cf6; }
.um-drop-hint { font-size: 0.75rem; color: var(--muted-foreground); margin-top: 0.375rem; }

.um-file-input {
  position: absolute; inset: 0; width: 100%; height: 100%;
  opacity: 0; cursor: pointer; z-index: 1;
}

/* ── File Preview (single) ── */
.um-file-preview {
  display: none; align-items: center; justify-content: space-between;
  position: relative; z-index: 10;
  padding: 0.75rem; border-radius: 0.75rem;
  background: var(--background); border: 1px solid var(--border);
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
}
.um-file-preview.show { display: flex; }
.um-file-preview-info { display: flex; align-items: center; gap: 0.75rem; overflow: hidden; }
.um-file-ext {
  width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 0.6875rem; font-weight: 700; flex-shrink: 0;
}
.um-file-name { font-size: 0.875rem; font-weight: 600; color: var(--card-foreground); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 16rem; }
.um-file-size { font-size: 0.75rem; color: var(--muted-foreground); margin-top: 0.125rem; }
.um-clear-btn {
  padding: 0.4rem; border-radius: 0.4rem; background: transparent; border: none;
  color: var(--muted-foreground); cursor: pointer; flex-shrink: 0; transition: all 0.15s;
}
.um-clear-btn:hover { color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); }

/* ── Multiple Documentation Preview ── */
.doc-file-list {
  display: none; flex-direction: column; gap: 0.5rem;
  position: relative; z-index: 10; margin-top: 0.75rem;
}
.doc-file-list.show { display: flex; }
.doc-file-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.625rem 0.75rem; border-radius: 0.625rem;
  background: var(--background); border: 1px solid var(--border);
}
.doc-file-item-info { display: flex; align-items: center; gap: 0.625rem; overflow: hidden; }
.doc-file-thumb {
  width: 2.25rem; height: 2.25rem; border-radius: 0.4rem;
  background: color-mix(in srgb, #8b5cf6 15%, transparent); color: #8b5cf6;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  font-size: 0.625rem; font-weight: 700;
}
.doc-file-name {
  font-size: 0.8125rem; font-weight: 600; color: var(--card-foreground);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 14rem;
}
.doc-file-size { font-size: 0.6875rem; color: var(--muted-foreground); }
.doc-remove-btn {
  padding: 0.3rem; border-radius: 0.3rem; background: transparent; border: none;
  color: var(--muted-foreground); cursor: pointer; flex-shrink: 0;
}
.doc-remove-btn:hover { color: #ef4444; background: color-mix(in srgb, #ef4444 10%, transparent); }
.doc-count-pill {
  display: inline-flex; align-items: center; gap: 0.375rem;
  font-size: 0.75rem; font-weight: 700; color: #8b5cf6;
  background: color-mix(in srgb, #8b5cf6 12%, transparent);
  padding: 0.2rem 0.625rem; border-radius: 999px; margin-top: 0.625rem;
}

/* ── Submit Button ── */
.um-submit-row { display: flex; justify-content: flex-end; padding-top: 1rem; }
.um-btn-green {
  display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
  padding: 0 1.5rem; min-height: 42px; border-radius: 0.75rem;
  background: #059669; color: #fff; font-size: 0.84375rem; font-weight: 800;
  border: none; cursor: pointer; transition: all 0.2s;
  box-shadow: 0 8px 20px color-mix(in srgb, #059669 25%, transparent);
}
.um-btn-green:hover { background: #047857; transform: translateY(-1px); box-shadow: 0 12px 24px color-mix(in srgb, #059669 30%, transparent); }
.um-btn-green svg { transition: transform 0.2s; }
.um-btn-green:hover svg { transform: translateY(-1px); }

/* ── History Section ── */
.um-history-title {
  display: flex; align-items: center; gap: 0.75rem;
  font-size: 1.0625rem; font-weight: 800; color: var(--card-foreground); letter-spacing: -0.02em;
}
.um-count-badge {
  font-size: 0.6875rem; font-weight: 700;
  background: color-mix(in srgb, var(--muted) 60%, transparent);
  border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  color: var(--muted-foreground); padding: 0.2rem 0.625rem; border-radius: 999px;
}

/* ── Filter Select ── */
.um-filter-select {
  min-width: 200px; padding: 0.5rem 0.875rem; border-radius: 0.5rem;
  border: 1.5px solid var(--border); background: var(--background);
  color: var(--foreground); font-size: 0.875rem; outline: none; font-family: inherit;
  transition: border-color 0.15s;
}
.um-filter-select:focus { border-color: #10b981; }

/* ── Empty State ── */
.um-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 5rem 1.5rem; color: var(--muted-foreground); position: relative; overflow: hidden;
}
.um-empty::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--muted) 20%, transparent));
  pointer-events: none;
}
.um-empty-icon {
  width: 5rem; height: 5rem; border-radius: 1.5rem;
  background: color-mix(in srgb, var(--muted) 50%, transparent);
  border: 1px solid color-mix(in srgb, var(--border) 50%, transparent);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 1.25rem; position: relative; z-index: 1;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05); transition: all 0.4s;
}
.um-empty:hover .um-empty-icon { transform: scale(1.1); box-shadow: 0 4px 16px rgba(0,0,0,0.1); }
.um-empty:hover .um-empty-icon svg { color: #10b981; }
.um-empty-icon svg { width: 2.5rem; height: 2.5rem; color: var(--muted-foreground); transition: color 0.3s; }
.um-empty-title { font-size: 1.0625rem; font-weight: 800; color: var(--card-foreground); position: relative; z-index: 1; letter-spacing: -0.02em; }
.um-empty-desc { font-size: 0.8125rem; color: var(--muted-foreground); margin-top: 0.5rem; text-align: center; max-width: 22rem; font-weight: 500; position: relative; z-index: 1; }

/* ── Table ── */
.um-table-wrap { overflow-x: auto; }
.um-table { width: 100%; font-size: 0.875rem; border-collapse: collapse; }
.um-table thead tr {
  background: color-mix(in srgb, var(--muted) 30%, transparent);
  border-bottom: 1px solid var(--border);
}
.um-table th {
  padding: 0.75rem 1rem; text-align: left;
  font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--muted-foreground); white-space: nowrap;
}
.um-table th.center { text-align: center; }
.um-table tbody tr {
  border-bottom: 1px solid color-mix(in srgb, var(--border) 60%, transparent);
  background: var(--card); transition: all 0.2s;
}
.um-table tbody tr:last-child { border-bottom: none; }
.um-table tbody tr:hover { background: color-mix(in srgb, var(--muted) 30%, transparent); }
.um-table td { padding: 1rem; vertical-align: middle; }
.um-table td.center { text-align: center; }

.um-td-title { font-weight: 600; color: var(--card-foreground); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.um-td-note { font-size: 0.75rem; color: var(--muted-foreground); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 12rem; }
.um-td-note-empty { font-size: 0.75rem; color: var(--muted-foreground); opacity: 0.5; font-style: italic; }
.um-td-date { font-size: 0.75rem; color: var(--muted-foreground); white-space: nowrap; }

/* File link */
.um-file-link {
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.375rem 0.75rem; border-radius: 0.5rem;
  background: color-mix(in srgb, var(--muted) 40%, transparent);
  border: 1px solid var(--border);
  font-size: 0.75rem; font-weight: 700; color: var(--card-foreground);
  text-decoration: none; transition: all 0.2s;
}
.um-file-link:hover {
  background: color-mix(in srgb, #10b981 10%, transparent);
  color: #10b981; border-color: color-mix(in srgb, #10b981 40%, transparent);
}
.um-file-link-icon-wrap {
  padding: 0.25rem; border-radius: 0.3rem;
  background: var(--background); box-shadow: 0 1px 2px rgba(0,0,0,0.08);
  display: flex; transition: background 0.2s;
}
.um-file-link:hover .um-file-link-icon-wrap { background: color-mix(in srgb, #10b981 15%, transparent); }
.um-file-link svg { width: 0.875rem; height: 0.875rem; color: var(--muted-foreground); transition: color 0.2s; }
.um-file-link:hover svg { color: #10b981; }

/* Doc count badge in table */
.um-doc-badge {
  display: inline-flex; align-items: center; gap: 0.375rem;
  padding: 0.3rem 0.625rem; border-radius: 0.5rem;
  background: color-mix(in srgb, #8b5cf6 12%, transparent);
  border: 1px solid color-mix(in srgb, #8b5cf6 30%, transparent);
  font-size: 0.75rem; font-weight: 700; color: #8b5cf6;
}
.um-doc-badge-empty {
  font-size: 0.75rem; color: var(--muted-foreground); opacity: 0.5; font-style: italic;
}

/* Action buttons */
.um-actions { display: flex; align-items: center; justify-content: center; gap: 0.375rem; }
.um-action-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2rem; height: 2rem; border-radius: 0.4rem;
  border: none; cursor: pointer; transition: all 0.15s;
}
.um-action-btn svg { width: 1rem; height: 1rem; }
.um-action-btn.green { background: color-mix(in srgb, #10b981 12%, transparent); color: #10b981; }
.um-action-btn.green:hover { background: color-mix(in srgb, #10b981 22%, transparent); }
.um-action-btn.amber { background: color-mix(in srgb, #f59e0b 12%, transparent); color: #f59e0b; }
.um-action-btn.amber:hover { background: color-mix(in srgb, #f59e0b 22%, transparent); }
.um-action-btn.red { background: color-mix(in srgb, #ef4444 12%, transparent); color: #ef4444; }
.um-action-btn.red:hover { background: color-mix(in srgb, #ef4444 22%, transparent); }
.um-view-only {
  padding: 0.2rem 0.5rem; font-size: 0.625rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  background: color-mix(in srgb, var(--muted) 50%, transparent); color: var(--muted-foreground);
  border-radius: 0.375rem;
}

/* ── Modal ── */
.um-modal-overlay {
  position: fixed; inset: 0; z-index: 50;
  display: none; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
  padding: 1rem; opacity: 0; transition: opacity 0.2s;
}
.um-modal-overlay.open { display: flex; }
.um-modal-overlay.visible { opacity: 1; }
.um-modal-box {
  background: var(--card); border: 1px solid var(--border);
  border-radius: 1rem; box-shadow: 0 24px 64px rgba(0,0,0,0.25);
  width: 100%; max-width: 28rem; overflow: hidden;
  transform: scale(0.95); opacity: 0; transition: all 0.2s;
}
.um-modal-box.visible { transform: scale(1); opacity: 1; }
.um-modal-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border);
  background: color-mix(in srgb, var(--muted) 30%, transparent);
}
.um-modal-title {
  display: flex; align-items: center; gap: 0.625rem;
  font-size: 0.9375rem; font-weight: 700; color: var(--card-foreground);
}
.um-modal-close {
  padding: 0.375rem; border-radius: 0.375rem; border: none; cursor: pointer;
  background: transparent; color: var(--muted-foreground); transition: all 0.15s;
}
.um-modal-close:hover { color: var(--card-foreground); background: color-mix(in srgb, var(--muted) 60%, transparent); }
.um-modal-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem; }
.um-modal-desc { font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6; }
.um-modal-footer { display: flex; justify-content: flex-end; gap: 0.75rem; padding-top: 0.75rem; }

.um-btn-cancel {
  padding: 0 1.25rem; min-height: 38px; border-radius: 0.5rem;
  background: color-mix(in srgb, var(--muted) 60%, transparent);
  border: 1px solid var(--border); color: var(--card-foreground);
  font-size: 0.875rem; font-weight: 600; cursor: pointer; transition: all 0.15s;
}
.um-btn-cancel:hover { background: color-mix(in srgb, var(--muted) 90%, transparent); }
.um-btn-amber {
  padding: 0 1.25rem; min-height: 38px; border-radius: 0.5rem;
  background: #f59e0b; color: #fff; border: none;
  font-size: 0.875rem; font-weight: 700; cursor: pointer; transition: all 0.15s;
  box-shadow: 0 4px 12px color-mix(in srgb, #f59e0b 30%, transparent);
}
.um-btn-amber:hover { background: #d97706; }
.um-btn-amber:active { transform: scale(0.98); }

@media (max-width: 768px) {
  .um-table th.hide-md, .um-table td.hide-md { display: none; }
}
@media (max-width: 640px) {
  .um-table th.hide-sm, .um-table td.hide-sm { display: none; }
}
</style>

<div class="um-page">

  <% if (messages && messages.error && messages.error.length > 0) { %>
  <div style="
    display:flex; align-items:center; gap:0.75rem;
    padding:1rem 1.25rem; border-radius:0.75rem;
    background:color-mix(in srgb,#ef4444 10%,transparent);
    border:1px solid color-mix(in srgb,#ef4444 30%,transparent);
    color:#ef4444; font-size:0.875rem; font-weight:600;">
    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
    </svg>
    <%= messages.error[0] %>
  </div>
<% } %>

  <!-- ── Page Header ── -->
  <div class="um-header">
    <h1>Upload Notulensi dan Dokumentasi</h1>
    <p>Unggah, kelola, dan pantau dokumentasi hasil rapat secara terpusat dengan mudah.</p>
  </div>

  <!-- ── FORM UPLOAD ── -->
  <div class="um-card">
    <div class="um-card-header">
      <h2 class="um-card-title">
        <span class="um-icon-box um-icon-emerald">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </span>
        Form Upload Notulensi
      </h2>
    </div>

    <form action="/meetings/upload-minutes" method="POST" enctype="multipart/form-data" class="um-form-body">

      <div class="um-grid-2">
        <div class="um-field">
          <label class="um-label">Pilih Rapat <span class="req">*</span></label>
          <select name="meeting_id" required class="um-select">
            <option value="" disabled selected>-- Pilih rapat --</option>
            <% meetings.forEach(m => { %>
              <option value="<%= m.id %>">
                <%= m.title %> &mdash;
                <%= new Date(m.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="um-field">
        <label class="um-label">Catatan / Ringkasan</label>
        <textarea name="notes" rows="3" placeholder="Tuliskan ringkasan atau catatan hasil rapat di sini..."
          class="um-textarea"></textarea>
      </div>

      <div class="um-field">
        <label class="um-label">File Notulensi <span class="req">*</span></label>

        <div id="dropZone" class="um-dropzone">
          <div id="dropContent" class="space-y-3">
            <div class="um-drop-icon-wrap">
              <svg class="um-drop-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
            </div>
            <div>
              <p class="um-drop-label"><span class="um-drop-link">Klik untuk pilih</span> atau seret file</p>
              <p class="um-drop-hint">PDF, Word (.doc/.docx), JPG, PNG &bull; Maks 10MB</p>
            </div>
          </div>

          <div id="filePreview" class="um-file-preview">
            <div class="um-file-preview-info">
              <div id="fileIcon" class="um-file-ext"></div>
              <div style="overflow:hidden">
                <p id="fileName" class="um-file-name"></p>
                <p id="fileSize" class="um-file-size"></p>
              </div>
            </div>
            <button type="button" id="clearFile" class="um-clear-btn" title="Hapus pilihan">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <input type="file" id="fileInput" name="file_notulensi" required
            accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
            class="um-file-input" />
        </div>
      </div>

      <!-- ── Field: Dokumentasi Foto Rapat (multiple) ── -->
      <div class="um-field">
        <label class="um-label">Dokumentasi Foto Rapat <span class="opt">(opsional, bisa lebih dari 1 foto)</span></label>

        <div id="docDropZone" class="um-dropzone violet-zone">
          <div id="docDropContent">
            <div class="um-drop-icon-wrap">
              <svg class="um-drop-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="um-drop-label"><span class="um-drop-link">Klik untuk pilih</span> atau seret beberapa foto</p>
              <p class="um-drop-hint">JPG, PNG &bull; Maks 10MB per file &bull; Bisa pilih banyak sekaligus</p>
            </div>
          </div>

          <div id="docFileList" class="doc-file-list"></div>

          <input type="file" id="docFileInput" name="file_dokumentasi" multiple
            accept=".jpg,.jpeg,.png"
            class="um-file-input" />
        </div>
      </div>

      <div class="um-submit-row">
        <button type="submit" class="um-btn-green">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          Upload Sekarang
        </button>
      </div>
    </form>
  </div>

  <!-- ── DAFTAR NOTULENSI ── -->
  <div class="um-card">
    <div class="um-card-header">
      <h2 class="um-history-title">
        <span class="um-icon-box um-icon-neutral">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z"/>
          </svg>
        </span>
        Riwayat Notulensi
        <% if (minutesList.length > 0) { %>
          <span class="um-count-badge"><%= minutesList.length %> File</span>
        <% } %>
      </h2>

      <form method="GET" action="/meetings/upload-minutes">
        <select name="meeting_id" onchange="this.form.submit()" class="um-filter-select">
          <option value="">Semua Rapat</option>
          <% meetingsWithMinutes.forEach(m => { %>
            <option value="<%= m.id %>" <%= selectedMeetingId == m.id ? 'selected' : '' %>>
              <%= m.title %>
            </option>
          <% }) %>
        </select>
      </form>
    </div>

    <% if (minutesList.length === 0) { %>
      <div class="um-empty">
        <div class="um-empty-icon">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <p class="um-empty-title">Belum ada notulensi</p>
        <p class="um-empty-desc">Data notulensi yang telah diupload akan tampil di daftar ini. Mulai dengan mengunggah file pertama Anda.</p>
      </div>
    <% } else { %>
      <div class="um-table-wrap">
        <table class="um-table">
          <thead>
            <tr>
              <th>Rapat</th>
              <th>File</th>
              <th class="hide-md">Dokumentasi</th>
              <th class="hide-md">Catatan</th>
              <th class="hide-sm">Diunggah</th>
              <th class="center">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% minutesList.forEach(m => { %>
            <tr>
              <td><span class="um-td-title"><%= m.meeting_title %></span></td>
              <td>
                <% if (m.file_path) { %>
                  <a href="<%= m.file_path %>" target="_blank" class="um-file-link">
                    <span class="um-file-link-icon-wrap">
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                      </svg>
                    </span>
                    Buka Dokumen
                  </a>
                <% } else { %>
                  <span style="font-size:0.75rem;color:var(--muted-foreground)">—</span>
                <% } %>
              </td>
              <td class="hide-md">
                <% if (m.documentation_count && m.documentation_count > 0) { %>
                  <span class="um-doc-badge">
                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <%= m.documentation_count %> Foto
                  </span>
                <% } else { %>
                  <span class="um-doc-badge-empty">Tidak ada</span>
                <% } %>
              </td>
              <td class="hide-md">
                <% if (m.summary) { %>
                  <span class="um-td-note" title="<%= m.summary %>"><%= m.summary %></span>
                <% } else { %>
                  <span class="um-td-note-empty">Tidak ada catatan</span>
                <% } %>
              </td>
              <td class="hide-sm">
                <span class="um-td-date"><%= m.uploaded_at %></span>
              </td>
              <td class="center">
                <div class="um-actions">
                  <a href="/meetings/minutes/<%= m.id %>/export-pdf" title="Export PDF" class="um-action-btn green">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11v6m0 0l-2.5-2.5M12 17l2.5-2.5"/>
                    </svg>
                  </a>
                  <% if (m.organizer_id === currentUserId) { %>
                    <button type="button" title="Ganti File" onclick="openReplaceModal('<%= m.id %>')"
                      class="um-action-btn amber">
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                      </svg>
                    </button>
                    <form action="/meetings/minutes/<%= m.id %>/delete" method="POST"
                      onsubmit="return confirm('Hapus notulensi ini? File juga akan dihapus permanen.')"
                      style="display:inline">
                      <button type="submit" title="Hapus" class="um-action-btn red">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                      </button>
                    </form>
                  <% } else { %>
                    <span class="um-view-only">Lihat Saja</span>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div style="padding-bottom:0.5rem"></div>
    <% } %>
  </div>

</div>

<!-- ── MODAL: Ganti File ── -->
<div id="replaceModal" class="um-modal-overlay">
  <div id="replaceModalBox" class="um-modal-box">
    <div class="um-modal-header">
      <h3 class="um-modal-title">
        <span class="um-icon-box" style="width:1.75rem;height:1.75rem;border-radius:0.375rem;background:color-mix(in srgb,#f59e0b 15%,transparent);color:#f59e0b;">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
        </span>
        Ganti File Notulensi
      </h3>
      <button onclick="closeReplaceModal()" class="um-modal-close">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="um-modal-body">
      <p class="um-modal-desc">File lama akan dihapus permanen dan digantikan dengan file baru yang Anda unggah.</p>

      <form id="replaceForm" method="POST" enctype="multipart/form-data">
        <div class="um-field" style="margin-bottom:1.25rem">
          <label class="um-label">Upload File Baru <span class="opt">(opsional)</span></label>

          <div id="replaceDropZone" class="um-dropzone amber-zone" style="margin-top:0.5rem">
            <div id="replaceDropContent">
              <div class="um-drop-icon-wrap">
                <svg class="um-drop-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
              </div>
              <div>
                <p class="um-drop-label"><span class="um-drop-link">Klik untuk pilih</span> atau seret file</p>
                <p class="um-drop-hint">PDF, Word, JPG, PNG &bull; Maks 10MB</p>
              </div>
            </div>

            <div id="replaceFilePreview" class="um-file-preview">
              <div class="um-file-preview-info">
                <div id="replaceFileIcon" class="um-file-ext"></div>
                <div style="overflow:hidden">
                  <p id="replaceFileName" class="um-file-name" style="max-width:13rem"></p>
                  <p id="replaceFileSize" class="um-file-size"></p>
                </div>
              </div>
              <button type="button" id="replaceClearFile" class="um-clear-btn" title="Hapus pilihan">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>

            <input type="file" id="replaceFileInput" name="file_notulensi"
              accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
              class="um-file-input" />
          </div>
        </div>

        <div class="um-field" style="margin-bottom:1.25rem">
          <label class="um-label">Tambah Foto Dokumentasi <span class="opt">(opsional)</span></label>

          <div id="replaceDocZone" class="um-dropzone violet-zone" style="margin-top:0.5rem">
            <div id="replaceDocContent">
              <div class="um-drop-icon-wrap">
                <svg class="um-drop-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="um-drop-label"><span class="um-drop-link">Klik untuk pilih</span> atau seret foto</p>
                <p class="um-drop-hint">JPG, PNG &bull; Maks 10MB per file &bull; Bisa pilih banyak</p>
              </div>
            </div>
            <div id="replaceDocList" class="doc-file-list"></div>
            <input type="file" id="replaceDocInput" name="file_dokumentasi" multiple
              accept=".jpg,.jpeg,.png" class="um-file-input" />
          </div>
        </div>

        <div class="um-modal-footer">
          <button type="button" onclick="closeReplaceModal()" class="um-btn-cancel">Batal</button>
          <button type="submit" class="um-btn-amber">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const EXT_COLORS = {
    pdf:  { bg: '#ef4444', label: 'PDF' },
    doc:  { bg: '#2563eb', label: 'DOC' },
    docx: { bg: '#2563eb', label: 'DOC' },
    jpg:  { bg: '#f59e0b', label: 'IMG' },
    jpeg: { bg: '#f59e0b', label: 'IMG' },
    png:  { bg: '#8b5cf6', label: 'PNG' },
  };

  function formatBytes(b) {
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(1) + ' MB';
  }
  function getExt(name) { return name.split('.').pop().toLowerCase(); }

  function showFilePreview(file, iconEl, nameEl, sizeEl, contentEl, previewEl, inputEl) {
    const ext  = getExt(file.name);
    const meta = EXT_COLORS[ext] || { bg: '#6b7280', label: ext.toUpperCase() };
    iconEl.style.backgroundColor = meta.bg;
    iconEl.textContent = meta.label;
    nameEl.textContent = file.name;
    sizeEl.textContent = formatBytes(file.size);
    contentEl.classList.add('hidden');
    previewEl.classList.add('show');
    inputEl.style.pointerEvents = 'none';
  }

  function resetPreview(inputEl, contentEl, previewEl) {
    inputEl.value = '';
    inputEl.style.pointerEvents = 'auto';
    previewEl.classList.remove('show');
    contentEl.classList.remove('hidden');
  }

  function setupDropZone(zoneId, inputId, contentId, previewId, iconId, nameId, sizeId, clearId) {
    const zone    = document.getElementById(zoneId);
    const input   = document.getElementById(inputId);
    const content = document.getElementById(contentId);
    const preview = document.getElementById(previewId);
    const icon    = document.getElementById(iconId);
    const name    = document.getElementById(nameId);
    const size    = document.getElementById(sizeId);
    const clear   = document.getElementById(clearId);

    input.addEventListener('change', () => {
      if (input.files[0]) showFilePreview(input.files[0], icon, name, size, content, preview, input);
    });
    clear.addEventListener('click', (e) => {
      e.preventDefault(); e.stopPropagation();
      resetPreview(input, content, preview);
    });
    zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('drag-over'); });
    zone.addEventListener('dragleave', () => zone.classList.remove('drag-over'));
    zone.addEventListener('drop', (e) => {
      e.preventDefault(); zone.classList.remove('drag-over');
      const file = e.dataTransfer.files[0];
      if (!file) return;
      const dt = new DataTransfer(); dt.items.add(file); input.files = dt.files;
      showFilePreview(file, icon, name, size, content, preview, input);
    });
  }

  setupDropZone('dropZone','fileInput','dropContent','filePreview','fileIcon','fileName','fileSize','clearFile');
  setupDropZone('replaceDropZone','replaceFileInput','replaceDropContent','replaceFilePreview','replaceFileIcon','replaceFileName','replaceFileSize','replaceClearFile');

  // ── Multiple file dokumentasi ──────────────────────────────────────
  let docFiles = [];

  const docInput   = document.getElementById('docFileInput');
  const docList    = document.getElementById('docFileList');
  const docContent = document.getElementById('docDropContent');
  const docZone    = document.getElementById('docDropZone');

  function renderDocList() {
    docList.innerHTML = '';
    if (docFiles.length === 0) {
      docList.classList.remove('show');
      return;
    }
    docList.classList.add('show');
    docFiles.forEach((file, idx) => {
      const ext = getExt(file.name);
      const item = document.createElement('div');
      item.className = 'doc-file-item';
      item.innerHTML = `
        <div class="doc-file-item-info">
          <div class="doc-file-thumb">${ext.toUpperCase()}</div>
          <div style="overflow:hidden">
            <p class="doc-file-name">${file.name}</p>
            <p class="doc-file-size">${formatBytes(file.size)}</p>
          </div>
        </div>
        <button type="button" class="doc-remove-btn" data-idx="${idx}">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>`;
      docList.appendChild(item);
    });

    docList.querySelectorAll('.doc-remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        const idx = parseInt(btn.dataset.idx, 10);
        docFiles.splice(idx, 1);
        syncDocInput();
        renderDocList();
      });
    });
  }

  function syncDocInput() {
    const dt = new DataTransfer();
    docFiles.forEach(f => dt.items.add(f));
    docInput.files = dt.files;
  }

  function addDocFiles(newFiles) {
    Array.from(newFiles).forEach(f => docFiles.push(f));
    syncDocInput();
    renderDocList();
  }

  docInput.addEventListener('change', () => {
    addDocFiles(docInput.files);
  });

  docZone.addEventListener('dragover', (e) => { e.preventDefault(); docZone.classList.add('drag-over'); });
  docZone.addEventListener('dragleave', () => docZone.classList.remove('drag-over'));
  docZone.addEventListener('drop', (e) => {
    e.preventDefault();
    docZone.classList.remove('drag-over');
    addDocFiles(e.dataTransfer.files);
  });

  function openReplaceModal(minuteId) {
    document.getElementById('replaceForm').action = '/meetings/minutes/' + minuteId + '/replace';
    resetPreview(
      document.getElementById('replaceFileInput'),
      document.getElementById('replaceDropContent'),
      document.getElementById('replaceFilePreview')
    );
    const modal = document.getElementById('replaceModal');
    const box   = document.getElementById('replaceModalBox');
    modal.classList.add('open');
    requestAnimationFrame(() => {
      modal.classList.add('visible');
      box.classList.add('visible');
    });
  }

  function closeReplaceModal() {
    const modal = document.getElementById('replaceModal');
    const box   = document.getElementById('replaceModalBox');
    modal.classList.remove('visible');
    box.classList.remove('visible');
    setTimeout(() => modal.classList.remove('open'), 200);
    replaceDocFiles = [];
    renderReplaceDocList();
  }

  // ── Multiple foto dokumentasi di modal replace ──────────────────────
  let replaceDocFiles = [];

  const replaceDocInput = document.getElementById('replaceDocInput');
  const replaceDocList  = document.getElementById('replaceDocList');
  const replaceDocZone  = document.getElementById('replaceDocZone');

  function renderReplaceDocList() {
    replaceDocList.innerHTML = '';
    if (replaceDocFiles.length === 0) { replaceDocList.classList.remove('show'); return; }
    replaceDocList.classList.add('show');
    replaceDocFiles.forEach((file, idx) => {
      const ext = getExt(file.name);
      const item = document.createElement('div');
      item.className = 'doc-file-item';
      item.innerHTML = `
        <div class="doc-file-item-info">
          <div class="doc-file-thumb">${ext.toUpperCase()}</div>
          <div style="overflow:hidden">
            <p class="doc-file-name">${file.name}</p>
            <p class="doc-file-size">${formatBytes(file.size)}</p>
          </div>
        </div>
        <button type="button" class="doc-remove-btn" data-idx="${idx}">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>`;
      replaceDocList.appendChild(item);
    });
    replaceDocList.querySelectorAll('.doc-remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        replaceDocFiles.splice(parseInt(btn.dataset.idx, 10), 1);
        syncReplaceDocInput();
        renderReplaceDocList();
      });
    });
  }

  function syncReplaceDocInput() {
    const dt = new DataTransfer();
    replaceDocFiles.forEach(f => dt.items.add(f));
    replaceDocInput.files = dt.files;
  }

  function addReplaceDocFiles(newFiles) {
    Array.from(newFiles).forEach(f => replaceDocFiles.push(f));
    syncReplaceDocInput();
    renderReplaceDocList();
  }

  replaceDocInput.addEventListener('change', () => addReplaceDocFiles(replaceDocInput.files));
  replaceDocZone.addEventListener('dragover', (e) => { e.preventDefault(); replaceDocZone.classList.add('drag-over'); });
  replaceDocZone.addEventListener('dragleave', () => replaceDocZone.classList.remove('drag-over'));
  replaceDocZone.addEventListener('drop', (e) => {
    e.preventDefault(); replaceDocZone.classList.remove('drag-over');
    addReplaceDocFiles(e.dataTransfer.files);
  });

  document.getElementById('replaceModal').addEventListener('click', function(e) {
    if (e.target === this) closeReplaceModal();
  });
</script>

<%- include('../partials/footer') %>
