<%- include('../partials/header') %>

<div class="p-6 md:p-8 max-w-5xl mx-auto space-y-8">

  <!-- ── Page Header ── -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">Upload Notulensi</h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Unggah dan kelola file notulensi rapat.</p>
    </div>
  </div>

  <!-- FORM UPLOAD -->
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-sm">
    <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800">
      <h2 class="text-base font-semibold text-zinc-800 dark:text-zinc-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Upload Notulensi Baru
      </h2>
    </div>

    <form action="/meetings/upload-minutes" method="POST" enctype="multipart/form-data" class="p-6 space-y-5">

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- Pilih Rapat -->
        <div class="flex flex-col gap-1.5">
          <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
            Pilih Rapat <span class="text-red-500">*</span>
          </label>
          <select name="meeting_id" required
            class="w-full border border-zinc-300 dark:border-zinc-700 rounded-lg px-3 py-2 text-sm
                   bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100
                   focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition">
            <option value="" disabled selected>-- Pilih rapat --</option>
            <% meetings.forEach(m => { %>
              <option value="<%= m.id %>">
                <%= m.title %> &mdash;
                <%= new Date(m.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Catatan / Summary -->
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">Catatan / Ringkasan</label>
        <textarea name="notes" rows="3"
          placeholder="Tuliskan ringkasan atau catatan hasil rapat di sini..."
          class="w-full border border-zinc-300 dark:border-zinc-700 rounded-lg px-3 py-2 text-sm
                 bg-white dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100 placeholder-zinc-400
                 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 resize-none transition"></textarea>
      </div>

      <!-- Upload File — Drag & Drop -->
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
          File Notulensi <span class="text-red-500">*</span>
        </label>

        <div id="dropZone"
          class="relative border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-xl px-6 py-8
                 hover:border-emerald-400 dark:hover:border-emerald-600 transition-all text-center cursor-pointer group">

          <div id="dropContent">
            <svg class="mx-auto mb-3 w-10 h-10 text-zinc-300 dark:text-zinc-600 group-hover:text-emerald-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400">
              Seret file ke sini, atau <span class="text-emerald-600 dark:text-emerald-400 underline">klik untuk pilih</span>
            </p>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-1.5">PDF, Word (.doc/.docx), JPG, PNG &bull; Maks 10MB</p>
          </div>

          <div id="filePreview" class="hidden items-center justify-center gap-3" style="position:relative; z-index:2;">
            <div id="fileIcon" class="w-10 h-10 rounded-lg flex items-center justify-center text-white text-xs font-bold shrink-0"></div>
            <div class="text-left">
              <p id="fileName" class="text-sm font-medium text-zinc-800 dark:text-zinc-100 truncate max-w-[260px]"></p>
              <p id="fileSize" class="text-xs text-zinc-400 mt-0.5"></p>
            </div>
            <button type="button" id="clearFile"
              style="position:relative; z-index:10;"
              class="ml-2 text-zinc-400 hover:text-red-500 transition-colors" title="Hapus pilihan">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <input type="file" id="fileInput" name="file_notulensi" required
            accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
            style="z-index:1;"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
        </div>
      </div>

      <div class="flex justify-end pt-1">
        <button type="submit"
          class="inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-5 py-2 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
          </svg>
          Upload Notulensi
        </button>
      </div>
    </form>
  </div>

  <!-- DAFTAR NOTULENSI -->
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-sm">
    <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <h2 class="text-base font-semibold text-zinc-800 dark:text-zinc-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z" />
        </svg>
        Daftar Notulensi
        <% if (minutesList.length > 0) { %>
          <span class="ml-1 text-xs font-normal bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 px-2 py-0.5 rounded-full">
            <%= minutesList.length %> file
          </span>
        <% } %>
      </h2>

      <form method="GET" action="/meetings/upload-minutes">
        <select name="meeting_id" onchange="this.form.submit()"
          class="border border-zinc-300 dark:border-zinc-700 rounded-lg px-3 py-1.5 text-sm
                 bg-white dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300
                 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition">
          <option value="">Semua Rapat</option>
          <% meetingsWithMinutes.forEach(m => { %>
            <option value="<%= m.id %>" <%= selectedMeetingId == m.id ? 'selected' : '' %>>
              <%= m.title %>
            </option>
          <% }) %>
        </select>
      </form>
    </div>

    <% if (minutesList.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-16 text-zinc-400 dark:text-zinc-600">
        <svg class="w-12 h-12 mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414A1 1 0 0119 9.414V19a2 2 0 01-2 2z" />
        </svg>
        <p class="text-sm font-medium">Belum ada notulensi</p>
        <p class="text-xs mt-1">Upload notulensi pertama menggunakan form di atas</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-zinc-50 dark:bg-zinc-800/50 border-b border-zinc-100 dark:border-zinc-800">
              <th class="text-left px-6 py-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">Rapat</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">File</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide hidden md:table-cell">Catatan</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide hidden sm:table-cell">Diunggah</th>
              <th class="text-center px-4 py-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
            <% minutesList.forEach(m => { %>
            <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
              <td class="px-6 py-4">
                <span class="font-medium text-zinc-800 dark:text-zinc-200 line-clamp-1"><%= m.meeting_title %></span>
              </td>
              <td class="px-4 py-4">
                <% if (m.file_path) { %>
                  <a href="<%= m.file_path %>" target="_blank"
                    class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:underline">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                    </svg>
                    Lihat File
                  </a>
                <% } else { %>
                  <span class="text-xs text-zinc-400">—</span>
                <% } %>
              </td>
              <td class="px-4 py-4 hidden md:table-cell max-w-[200px]">
                <% if (m.summary) { %>
                  <span class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2" title="<%= m.summary %>"><%= m.summary %></span>
                <% } else { %>
                  <span class="text-xs text-zinc-300 dark:text-zinc-600 italic">Tidak ada catatan</span>
                <% } %>
              </td>
              <td class="px-4 py-4 hidden sm:table-cell whitespace-nowrap">
                <span class="text-xs text-zinc-500 dark:text-zinc-400"><%= m.uploaded_at %></span>
              </td>
              <td class="px-4 py-4">
                <div class="flex items-center justify-center gap-1.5">
                  <a href="/meetings/minutes/<%= m.id %>/export-pdf" title="Export PDF"
                    class="inline-flex items-center justify-center w-8 h-8 rounded-lg
                           bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400
                           hover:bg-emerald-100 dark:hover:bg-emerald-900/40 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                  </a>
                  <button type="button" title="Ganti File" onclick="openReplaceModal('<%= m.id %>')"
                    class="inline-flex items-center justify-center w-8 h-8 rounded-lg
                           bg-amber-50 dark:bg-amber-900/20 text-amber-600 dark:text-amber-400
                           hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                    </svg>
                  </button>
                  <form action="/meetings/minutes/<%= m.id %>/delete" method="POST"
                    onsubmit="return confirm('Hapus notulensi ini? File juga akan dihapus permanen.')">
                    <button type="submit" title="Hapus"
                      class="inline-flex items-center justify-center w-8 h-8 rounded-lg
                             bg-red-50 dark:bg-red-900/20 text-red-500 dark:text-red-400
                             hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</div>

<!-- MODAL: Ganti File -->
<div id="replaceModal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm px-4">
  <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-2xl w-full max-w-md p-6 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-base font-semibold text-zinc-800 dark:text-zinc-100">Ganti File Notulensi</h3>
      <button onclick="closeReplaceModal()" class="text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-200 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <p class="text-sm text-zinc-500 dark:text-zinc-400">File lama akan dihapus dan digantikan dengan file baru yang kamu pilih.</p>

    <form id="replaceForm" method="POST" enctype="multipart/form-data" class="space-y-4">
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-medium text-zinc-700 dark:text-zinc-300">
          Pilih File Baru <span class="text-red-500">*</span>
        </label>
        <div id="replaceDropZone"
          class="relative border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-xl px-5 py-6
                 hover:border-amber-400 dark:hover:border-amber-600 transition-all text-center cursor-pointer group">

          <div id="replaceDropContent">
            <svg class="mx-auto mb-2 w-8 h-8 text-zinc-300 dark:text-zinc-600 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">
              Seret file ke sini, atau <span class="text-amber-600 dark:text-amber-400 underline">klik untuk pilih</span>
            </p>
            <p class="text-xs text-zinc-400 mt-1">PDF, Word, JPG, PNG &bull; Maks 10MB</p>
          </div>

          <div id="replaceFilePreview" class="hidden items-center justify-center gap-3" style="position:relative; z-index:2;">
            <div id="replaceFileIcon" class="w-9 h-9 rounded-lg flex items-center justify-center text-white text-xs font-bold shrink-0"></div>
            <div class="text-left">
              <p id="replaceFileName" class="text-sm font-medium text-zinc-800 dark:text-zinc-100 truncate max-w-[200px]"></p>
              <p id="replaceFileSize" class="text-xs text-zinc-400 mt-0.5"></p>
            </div>
            <button type="button" id="replaceClearFile"
              style="position:relative; z-index:10;"
              class="ml-2 text-zinc-400 hover:text-red-500 transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <input type="file" id="replaceFileInput" name="file_notulensi" required
            accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
            style="z-index:1;"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" />
        </div>
      </div>

      <div class="flex gap-3 pt-1">
        <button type="submit"
          class="flex-1 bg-amber-500 hover:bg-amber-600 text-white text-sm font-medium py-2 rounded-lg transition-colors">
          Ganti File
        </button>
        <button type="button" onclick="closeReplaceModal()"
          class="flex-1 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700
                 text-zinc-700 dark:text-zinc-300 text-sm font-medium py-2 rounded-lg transition-colors">
          Batal
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const EXT_COLORS = {
    pdf:  { bg: '#ef4444', label: 'PDF' },
    doc:  { bg: '#2563eb', label: 'DOC' },
    docx: { bg: '#2563eb', label: 'DOC' },
    jpg:  { bg: '#f59e0b', label: 'IMG' },
    jpeg: { bg: '#f59e0b', label: 'IMG' },
    png:  { bg: '#8b5cf6', label: 'PNG' },
  };

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function getExt(name) {
    return name.split('.').pop().toLowerCase();
  }

  function showFilePreview(file, iconEl, nameEl, sizeEl, dropContent, previewEl, inputEl) {
    const ext  = getExt(file.name);
    const meta = EXT_COLORS[ext] || { bg: '#6b7280', label: ext.toUpperCase() };
    iconEl.style.backgroundColor = meta.bg;
    iconEl.textContent            = meta.label;
    nameEl.textContent            = file.name;
    sizeEl.textContent            = formatBytes(file.size);
    dropContent.classList.add('hidden');
    previewEl.classList.remove('hidden');
    previewEl.classList.add('flex');
    // Sembunyikan input agar tidak menutupi tombol clear
    inputEl.style.pointerEvents = 'none';
  }

  function resetPreview(inputEl, dropContent, previewEl) {
    inputEl.value = '';
    inputEl.style.pointerEvents = 'auto';
    previewEl.classList.add('hidden');
    previewEl.classList.remove('flex');
    dropContent.classList.remove('hidden');
  }

  function setupDropZone(zoneId, inputId, contentId, previewId, iconId, nameId, sizeId, clearId, accentClass) {
    const zone    = document.getElementById(zoneId);
    const input   = document.getElementById(inputId);
    const content = document.getElementById(contentId);
    const preview = document.getElementById(previewId);
    const icon    = document.getElementById(iconId);
    const name    = document.getElementById(nameId);
    const size    = document.getElementById(sizeId);
    const clear   = document.getElementById(clearId);

    input.addEventListener('change', () => {
      if (input.files[0]) showFilePreview(input.files[0], icon, name, size, content, preview, input);
    });

    clear.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      resetPreview(input, content, preview);
    });

    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add(accentClass);
    });
    zone.addEventListener('dragleave', () => {
      zone.classList.remove(accentClass);
    });
    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove(accentClass);
      const file = e.dataTransfer.files[0];
      if (!file) return;
      const dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      showFilePreview(file, icon, name, size, content, preview, input);
    });
  }

  setupDropZone('dropZone', 'fileInput', 'dropContent', 'filePreview',
    'fileIcon', 'fileName', 'fileSize', 'clearFile', 'border-emerald-400');

  setupDropZone('replaceDropZone', 'replaceFileInput', 'replaceDropContent', 'replaceFilePreview',
    'replaceFileIcon', 'replaceFileName', 'replaceFileSize', 'replaceClearFile', 'border-amber-400');

  function openReplaceModal(minuteId) {
    document.getElementById('replaceForm').action = '/meetings/minutes/' + minuteId + '/replace';
    resetPreview(
      document.getElementById('replaceFileInput'),
      document.getElementById('replaceDropContent'),
      document.getElementById('replaceFilePreview')
    );
    const modal = document.getElementById('replaceModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeReplaceModal() {
    const modal = document.getElementById('replaceModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.getElementById('replaceModal').addEventListener('click', function(e) {
    if (e.target === this) closeReplaceModal();
  });
</script>

<%- include('../partials/footer') %>
