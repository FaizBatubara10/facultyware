            <div class="sidebar-brand-name">
              FTI<span class="sidebar-brand-dot"> </span>MEETING
            </div>
            <div class="sidebar-brand-sub">Pengelolaan Rapat</div>
          </a>
        </header>

        <section class="scrollbar" style="margin-top:1rem; padding:0 0.75rem">
          <div role="group">
            <div class="sidebar-section-label">Utama</div>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:0.25rem">
              <li>
                <a href="/home"
