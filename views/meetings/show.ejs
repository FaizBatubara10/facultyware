<%- include('../partials/header') %>

<div class="p-4 md:p-6 xl:p-8 bg-[#0c0c0e] min-h-screen text-white">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6">
      <a
        href="/meetings"
        class="inline-flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-semibold"
      >
        <span class="text-xl leading-none">←</span>
        <span>Kembali ke Daftar Meeting</span>
      </a>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">
          Detail Meeting
        </h1>

        <p class="text-zinc-400 text-sm mt-1">
          Informasi lengkap mengenai jadwal rapat yang dipilih.
        </p>
      </div>

      <div class="flex gap-2">
        <a
          href="/meetings/<%= meeting.id %>/edit"
          class="inline-flex justify-center items-center px-4 py-2 rounded-lg bg-emerald-700 text-white hover:bg-emerald-600 font-semibold text-sm transition-colors"
        >
          Edit
        </a>

        <form
          action="/meetings/<%= meeting.id %>/delete"
          method="POST"
          onsubmit="return confirm('Yakin ingin menghapus meeting ini?')"
        >
          <button
            type="submit"
            class="inline-flex justify-center items-center px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-500 font-semibold text-sm transition-colors"
          >
            Hapus
          </button>
        </form>
      </div>
    </div>

    <div class="bg-white text-zinc-900 rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">

      <div class="p-6 border-b border-zinc-200">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">

          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="capitalize px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                <%= meeting.status %>
              </span>

              <span class="capitalize px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                <%= meeting.meeting_type %>
              </span>
            </div>

            <h2 class="text-2xl md:text-3xl font-bold text-zinc-900">
              <%= meeting.title %>
            </h2>

            <p class="text-zinc-500 mt-3 leading-relaxed">
              <%= meeting.description || 'Tidak ada deskripsi atau agenda untuk meeting ini.' %>
            </p>
          </div>

          <div class="w-20 h-20 rounded-2xl bg-emerald-50 flex flex-col items-center justify-center shrink-0">
            <div class="text-xs font-bold text-zinc-400 uppercase">
              <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { month: 'short' }) %>
            </div>

            <div class="text-3xl font-black text-emerald-700 leading-none">
              <%= new Date(meeting.meeting_date).getDate() %>
            </div>
          </div>

        </div>
      </div>

      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Tanggal
            </p>

            <p class="font-bold text-zinc-900">
              <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Waktu Mulai
            </p>

            <p class="font-bold text-zinc-900">
              <%= meeting.start_time.substring(0,5) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Waktu Selesai
            </p>

            <p class="font-bold text-zinc-900">
              <%= meeting.end_time.substring(0,5) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Tipe
            </p>

            <p class="capitalize font-bold text-zinc-900">
              <%= meeting.meeting_type %>
            </p>
          </div>

        </div>
      </div>

      <div class="p-6 border-t border-zinc-200">
        <div class="flex items-center justify-between gap-4 mb-4">
          <div>
            <h3 class="text-lg font-bold text-zinc-900">
              Peserta Meeting
            </h3>

            <p class="text-sm text-zinc-500 mt-1">
              Daftar peserta yang terdaftar dalam meeting ini.
            </p>
          </div>

          <span class="px-3 py-1 rounded-full bg-zinc-100 text-zinc-600 text-xs font-semibold">
            <%= participants ? participants.length : 0 %> peserta
          </span>
        </div>

        <% if (participants && participants.length > 0) { %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <% participants.forEach(participant => { %>
              <div class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 p-4 bg-white">

                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm">
                    <%= participant.name ? participant.name.substring(0, 1).toUpperCase() : '?' %>
                  </div>

                  <div>
                    <p class="font-bold text-zinc-900">
                      <%= participant.name %>
                    </p>

                    <p class="text-xs text-zinc-400">
                      <%= participant.employee_number || 'Tidak ada nomor pegawai' %>
                    </p>
                  </div>
                </div>

                <span class="capitalize px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                  <%= participant.status %>
                </span>

              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl border border-dashed border-zinc-300 p-8 text-center">
            <p class="text-zinc-500 font-semibold">
              Belum ada peserta yang ditambahkan.
            </p>

            <p class="text-sm text-zinc-400 mt-1">
              Peserta dapat ditambahkan melalui halaman edit meeting.
            </p>
          </div>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>