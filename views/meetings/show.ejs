<%- include('../partials/header') %>

<%
  function formatTime(timeValue) {
    if (!timeValue) {
      return '-';
    }

    return String(timeValue).substring(0, 5);
  }

  function getDateObject(dateValue) {
    const date = new Date(dateValue);
    return isNaN(date.getTime()) ? null : date;
  }

  function formatMeetingDate(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.toLocaleDateString('id-ID', {
      day: '2-digit',
      month: 'long',
      year: 'numeric'
    });
  }

  function getMeetingMonth(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.toLocaleDateString('id-ID', {
      month: 'short'
    });
  }

  function getMeetingDay(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.getDate();
  }

  function getStatusLabel(status) {
    if (status === 'scheduled') return 'Scheduled';
    if (status === 'completed') return 'Completed';
    if (status === 'cancelled') return 'Cancelled';
    return 'Draft';
  }

  function getMeetingTypeLabel(type) {
    if (type === 'online') return 'Online';
    if (type === 'hybrid') return 'Hybrid';
    return 'Tatap Muka';
  }

  function getStatusClass(status) {
    if (status === 'scheduled') {
      return 'bg-emerald-50 text-emerald-700';
    }

    if (status === 'completed') {
      return 'bg-zinc-100 text-zinc-700';
    }

    if (status === 'cancelled') {
      return 'bg-red-50 text-red-700';
    }

    return 'bg-amber-50 text-amber-700';
  }

  const meetingStartTime = formatTime(meeting.start_time);
  const meetingEndTime = formatTime(meeting.end_time);
%>

<div class="p-4 md:p-6 xl:p-8 bg-[#0c0c0e] min-h-screen text-white">
  <div class="max-w-5xl mx-auto">

    <div class="mb-6">
      <a
        href="/meetings"
        class="inline-flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-semibold"
      >
        <span class="text-xl leading-none">←</span>
        <span>Kembali ke Daftar Meeting</span>
      </a>
    </div>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">
          Detail Meeting
        </h1>

        <p class="text-zinc-400 text-sm mt-1">
          Informasi lengkap mengenai jadwal rapat yang dipilih.
        </p>
      </div>

      <% if (typeof isHost !== 'undefined' && isHost) { %>
        <div class="flex gap-2">
          <a
            href="/meetings/<%= meeting.id %>/edit"
            class="inline-flex justify-center items-center px-4 py-2 rounded-lg bg-emerald-700 text-white hover:bg-emerald-600 font-semibold text-sm transition-colors"
          >
            Edit
          </a>

          <form
            action="/meetings/<%= meeting.id %>/delete"
            method="POST"
            onsubmit="return confirm('Yakin ingin menghapus meeting ini?')"
          >
            <button
              type="submit"
              class="inline-flex justify-center items-center px-4 py-2 rounded-lg bg-red-600 text-white hover:bg-red-500 font-semibold text-sm transition-colors"
            >
              Hapus
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <div class="bg-white text-zinc-900 rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">

      <div class="p-6 border-b border-zinc-200">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">

          <div>
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="capitalize px-3 py-1 rounded-full <%= getStatusClass(meeting.status) %> text-xs font-semibold">
                <%= getStatusLabel(meeting.status) %>
              </span>

              <span class="capitalize px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                <%= getMeetingTypeLabel(meeting.meeting_type) %>
              </span>
            </div>

            <h2 class="text-2xl md:text-3xl font-bold text-zinc-900">
              <%= meeting.title %>
            </h2>

            <p class="text-zinc-500 mt-3 leading-relaxed">
              <%= meeting.description || 'Tidak ada deskripsi atau agenda untuk meeting ini.' %>
            </p>
          </div>

          <div class="w-20 h-20 rounded-2xl bg-emerald-50 flex flex-col items-center justify-center shrink-0">
            <div class="text-xs font-bold text-zinc-400 uppercase">
              <%= getMeetingMonth(meeting.meeting_date) %>
            </div>

            <div class="text-3xl font-black text-emerald-700 leading-none">
              <%= getMeetingDay(meeting.meeting_date) %>
            </div>
          </div>

        </div>
      </div>

      <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Tanggal
            </p>

            <p class="font-bold text-zinc-900">
              <%= formatMeetingDate(meeting.meeting_date) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Waktu Mulai
            </p>

            <p class="font-bold text-zinc-900">
              <%= meetingStartTime %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Waktu Selesai
            </p>

            <p class="font-bold text-zinc-900">
              <%= meetingEndTime %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
              Tipe
            </p>

            <p class="capitalize font-bold text-zinc-900">
              <%= getMeetingTypeLabel(meeting.meeting_type) %>
            </p>
          </div>

        </div>

        <div class="mt-4 rounded-xl border border-zinc-200 p-4 bg-zinc-50">
          <p class="text-xs font-bold text-zinc-400 uppercase mb-1">
            Lokasi / Link Meeting
          </p>

          <% if (meeting.online_link) { %>
            <% if (String(meeting.online_link).startsWith('http')) { %>
              <a
                href="<%= meeting.online_link %>"
                target="_blank"
                class="font-bold text-emerald-700 hover:text-emerald-600 break-all"
              >
                <%= meeting.online_link %>
              </a>
            <% } else { %>
              <p class="font-bold text-zinc-900 break-all">
                <%= meeting.online_link %>
              </p>
            <% } %>
          <% } else { %>
            <p class="font-bold text-zinc-900">
              -
            </p>
          <% } %>
        </div>
      </div>

      <div class="p-6 border-t border-zinc-200">
        <div class="flex items-center justify-between gap-4 mb-4">
          <div>
            <h3 class="text-lg font-bold text-zinc-900">
              Peserta Meeting
            </h3>

            <p class="text-sm text-zinc-500 mt-1">
              Daftar peserta yang terdaftar dalam meeting ini.
            </p>
          </div>

          <span class="px-3 py-1 rounded-full bg-zinc-100 text-zinc-600 text-xs font-semibold">
            <%= participants ? participants.length : 0 %> peserta
          </span>
        </div>

        <% if (participants && participants.length > 0) { %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <% participants.forEach(function(participant) { %>
              <div class="flex items-center justify-between gap-3 rounded-xl border border-zinc-200 p-4 bg-white">

                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-sm shrink-0">
                    <%= participant.name ? participant.name.substring(0, 1).toUpperCase() : '?' %>
                  </div>

                  <div class="min-w-0">
                    <p class="font-bold text-zinc-900 truncate">
                      <%= participant.name %>
                    </p>

                    <p class="text-xs text-zinc-400">
                      <%= participant.employee_number || 'Tidak ada nomor pegawai' %>
                    </p>
                  </div>
                </div>

                <span class="capitalize px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold shrink-0">
                  <%= participant.status %>
                </span>

              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="rounded-xl border border-dashed border-zinc-300 p-8 text-center">
            <p class="text-zinc-500 font-semibold">
              Belum ada peserta yang ditambahkan.
            </p>

            <p class="text-sm text-zinc-400 mt-1">
              Peserta dapat ditambahkan melalui halaman edit meeting.
            </p>
          </div>
        <% } %>
      </div>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>