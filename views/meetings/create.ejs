<%- include('../partials/header') %>

<style>
    /*
        Halaman create meeting dibuat seperti modal besar.
        Form ini tidak punya opsi "Sampai Selesai",
        karena database asli mewajibkan end_time selalu terisi.
    */

    body {
        overflow: hidden;
    }

    .create-meeting-page {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px 16px;
        background: rgba(0, 0, 0, 0.45);
        overflow: hidden;
    }

    .meeting-modal {
        width: 100%;
        max-width: 720px;
        max-height: calc(100vh - 48px);
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .meeting-modal-header {
        flex-shrink: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 22px 28px;
        border-bottom: 1px solid #e5e5e5;
        background: #ffffff;
    }

    .meeting-modal-header h1 {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: #222222;
    }

    .close-link {
        text-decoration: none;
        font-size: 28px;
        color: #777777;
        line-height: 1;
    }

    .close-link:hover {
        color: #222222;
    }

    .meeting-form {
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .meeting-form-body {
        padding: 24px 28px;
        overflow-y: auto;
        min-height: 0;
    }

    .meeting-form-actions {
        flex-shrink: 0;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 18px 28px;
        border-top: 1px solid #e5e5e5;
        background: #ffffff;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 18px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #222222;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #d0d0d0;
        border-radius: 9px;
        font-size: 14px;
        color: #222222;
        outline: none;
        box-sizing: border-box;
        background-color: #ffffff;
    }

    .form-control:focus {
        border-color: #2f6f4e;
        box-shadow: 0 0 0 2px rgba(47, 111, 78, 0.12);
    }

    textarea.form-control {
        resize: vertical;
        min-height: 82px;
    }

    /*
        CUSTOM TIME PICKER

        User memilih jam dan menit dari panel custom.
        Waktu selesai wajib dipilih dan harus lebih besar dari waktu mulai.
    */

    .time-range-control {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 10px;
    }

    .time-input-wrapper {
        position: relative;
    }

    .time-display-input {
        width: 100%;
        padding: 12px 42px 12px 14px;
        border: 1px solid #d0d0d0;
        border-radius: 9px;
        font-size: 14px;
        color: #222222;
        outline: none;
        box-sizing: border-box;
        background-color: #ffffff;
        cursor: pointer;
    }

    .time-display-input:focus {
        border-color: #2f6f4e;
        box-shadow: 0 0 0 2px rgba(47, 111, 78, 0.12);
    }

    .time-icon {
        position: absolute;
        right: 13px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 16px;
        color: #666666;
        pointer-events: none;
    }

    .time-range-separator {
        font-weight: 700;
        color: #777777;
    }

    .time-picker-panel {
        position: fixed;
        z-index: 10000;
        width: 320px;
        max-width: calc(100vw - 32px);
        background: #ffffff;
        border: 1px solid #d0d0d0;
        border-radius: 12px;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.20);
        padding: 14px;
        display: none;
    }

    .time-picker-panel.active {
        display: block;
    }

    .time-picker-title {
        margin-bottom: 12px;
        font-size: 14px;
        font-weight: 700;
        color: #333333;
    }

    .time-picker-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .time-column {
        max-height: 185px;
        overflow-y: auto;
        border: 1px solid #eeeeee;
        border-radius: 9px;
        padding: 6px;
    }

    .time-column-label {
        position: sticky;
        top: 0;
        background: #ffffff;
        padding: 4px 6px 8px;
        font-size: 11px;
        font-weight: 700;
        color: #777777;
        z-index: 1;
    }

    .time-option {
        width: 100%;
        border: none;
        background: transparent;
        padding: 9px 8px;
        border-radius: 7px;
        font-size: 14px;
        color: #222222;
        cursor: pointer;
        text-align: center;
    }

    .time-option:hover {
        background: #f3f4f6;
    }

    .time-option.active {
        background: #2f6f4e;
        color: #ffffff;
        font-weight: 700;
    }

    .time-picker-note {
        margin-top: 8px;
        font-size: 12px;
        color: #777777;
        line-height: 1.4;
    }

    .participant-input-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
    }

    .btn-add-participant {
        padding: 0 18px;
        border: 1px solid #d0d0d0;
        border-radius: 9px;
        background: #ffffff;
        color: #222222;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-add-participant:hover {
        background: #f5f5f5;
    }

    .participant-list {
        margin-top: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .participant-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 9px 12px;
        border: 1px solid #e2e2e2;
        border-radius: 9px;
        background: #f8f8f8;
        font-size: 14px;
    }

    .participant-name {
        color: #222222;
    }

    .btn-remove-participant {
        border: none;
        background: transparent;
        color: #b42318;
        font-size: 13px;
        cursor: pointer;
    }

    .empty-participant-text {
        margin-top: 10px;
        font-size: 13px;
        color: #777777;
    }

    .btn-cancel {
        padding: 11px 16px;
        border: none;
        background: transparent;
        color: #555555;
        text-decoration: none;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-draft {
        padding: 11px 18px;
        border: 1px solid #d0d0d0;
        border-radius: 9px;
        background: #ffffff;
        color: #222222;
        font-size: 14px;
        cursor: pointer;
    }

    .btn-submit {
        padding: 11px 18px;
        border: none;
        border-radius: 9px;
        background: #2f6f4e;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-draft:hover {
        background: #f5f5f5;
    }

    .btn-submit:hover {
        background: #285f43;
    }

    @media (max-width: 640px) {
        .create-meeting-page {
            align-items: flex-start;
            padding: 16px 12px;
        }

        .meeting-modal {
            max-height: calc(100vh - 32px);
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .time-range-control {
            grid-template-columns: 1fr;
        }

        .time-range-separator {
            display: none;
        }

        .participant-input-row {
            grid-template-columns: 1fr;
        }

        .meeting-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
            padding: 16px 20px;
        }

        .btn-cancel,
        .btn-draft,
        .btn-submit {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="create-meeting-page">
    <div class="meeting-modal">
        <div class="meeting-modal-header">
            <h1>Buat Meeting Baru</h1>

            <a href="/meetings" class="close-link">
                &times;
            </a>
        </div>

        <form action="/meetings" method="POST" class="meeting-form">
            <div class="meeting-form-body">
                <div class="form-group">
                    <label for="title">Judul Meeting *</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        class="form-control"
                        placeholder="Contoh: Rapat Koordinasi Kurikulum Semester Ganjil"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Deskripsi / Agenda</label>

                    <textarea
                        id="description"
                        name="description"
                        class="form-control"
                        rows="4"
                        placeholder="Tuliskan agenda atau tujuan rapat..."
                    ></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="meeting_date">Tanggal *</label>

                        <input
                            type="date"
                            id="meeting_date"
                            name="meeting_date"
                            class="form-control"
                            onclick="this.showPicker && this.showPicker()"
                            onfocus="this.showPicker && this.showPicker()"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label>Waktu Meeting *</label>

                        <div class="time-range-control">
                            <div class="time-input-wrapper">
                                <input
                                    type="text"
                                    id="start_time_display"
                                    class="time-display-input"
                                    value="09:00"
                                    readonly
                                    data-picker-target="start"
                                >
                                <span class="time-icon">◷</span>
                            </div>

                            <span class="time-range-separator">-</span>

                            <div class="time-input-wrapper">
                                <input
                                    type="text"
                                    id="end_time_display"
                                    class="time-display-input"
                                    value="11:00"
                                    readonly
                                    data-picker-target="end"
                                >
                                <span class="time-icon">◷</span>
                            </div>
                        </div>

                        <!--
                            Input hidden ini yang dikirim ke controller.
                            Database asli mewajibkan start_time dan end_time terisi.
                        -->
                        <input type="hidden" id="start_time" name="start_time" value="09:00">
                        <input type="hidden" id="end_time" name="end_time" value="11:00">
                    </div>
                </div>

                <div class="form-group">
                    <label for="meeting_type">Tipe Meeting *</label>

                    <select
                        id="meeting_type"
                        name="meeting_type"
                        class="form-control"
                        required
                    >
                        <option value="offline">Tatap Muka</option>
                        <option value="online">Online</option>
                        <option value="hybrid">Hybrid</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="online_link">Lokasi / Link Meeting</label>

                    <input
                        type="text"
                        id="online_link"
                        name="online_link"
                        class="form-control"
                        placeholder="Ruang rapat / Link Zoom / Google Meet"
                    >
                </div>

                <div class="form-group">
                    <label for="employee_select">Peserta Awal</label>

                    <div class="participant-input-row">
                        <select id="employee_select" class="form-control">
                            <option value="">Pilih peserta...</option>

                            <% if (typeof employees !== 'undefined' && employees && employees.length > 0) { %>
                                <% employees.forEach(function(employee) { %>
                                    <option
                                        value="<%= employee.id %>"
                                        data-name="<%= employee.name %>"
                                    >
                                        <%= employee.name %>
                                        <% if (employee.employee_number) { %>
                                            - <%= employee.employee_number %>
                                        <% } %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>

                        <button
                            type="button"
                            class="btn-add-participant"
                            onclick="addParticipant()"
                        >
                            Tambah
                        </button>
                    </div>

                    <p id="emptyParticipantText" class="empty-participant-text">
                        Belum ada peserta yang ditambahkan.
                    </p>

                    <div id="participantList" class="participant-list"></div>

                    <input
                        type="hidden"
                        id="participant_ids"
                        name="participant_ids"
                        value=""
                    >
                </div>
            </div>

            <div class="meeting-form-actions">
                <a href="/meetings" class="btn-cancel">
                    Batal
                </a>

                <button
                    type="submit"
                    name="status"
                    value="draft"
                    class="btn-draft"
                >
                    Simpan Draft
                </button>

                <button
                    type="submit"
                    name="status"
                    value="scheduled"
                    class="btn-submit"
                >
                    Buat & Kirim Undangan
                </button>
            </div>
        </form>
    </div>
</div>

<div id="timePickerPanel" class="time-picker-panel">
    <div id="timePickerTitle" class="time-picker-title">
        Pilih Waktu
    </div>

    <div class="time-picker-columns">
        <div class="time-column">
            <div class="time-column-label">Jam</div>
            <div id="hourOptions"></div>
        </div>

        <div class="time-column">
            <div class="time-column-label">Menit</div>
            <div id="minuteOptions"></div>
        </div>
    </div>

    <div id="timePickerNote" class="time-picker-note">
        Pilih jam dan menit.
    </div>
</div>

<script>
    // =========================================================
    // PESERTA MEETING
    // =========================================================

    const selectedParticipants = [];

    function addParticipant() {
        const employeeSelect = document.getElementById('employee_select');
        const selectedOption = employeeSelect.options[employeeSelect.selectedIndex];

        const employeeId = employeeSelect.value;
        const employeeName = selectedOption.getAttribute('data-name');

        if (!employeeId) {
            alert('Silakan pilih peserta terlebih dahulu.');
            return;
        }

        if (selectedParticipants.includes(employeeId)) {
            alert('Peserta ini sudah ditambahkan.');
            return;
        }

        selectedParticipants.push(employeeId);
        renderParticipantList();

        employeeSelect.value = '';
    }

    function removeParticipant(employeeId) {
        const participantIndex = selectedParticipants.indexOf(employeeId);

        if (participantIndex !== -1) {
            selectedParticipants.splice(participantIndex, 1);
        }

        renderParticipantList();
    }

    function renderParticipantList() {
        const participantList = document.getElementById('participantList');
        const participantIdsInput = document.getElementById('participant_ids');
        const emptyParticipantText = document.getElementById('emptyParticipantText');
        const employeeSelect = document.getElementById('employee_select');

        participantList.innerHTML = '';

        emptyParticipantText.style.display = selectedParticipants.length === 0 ? 'block' : 'none';

        selectedParticipants.forEach(function(employeeId) {
            const option = employeeSelect.querySelector('option[value="' + employeeId + '"]');
            const employeeName = option ? option.getAttribute('data-name') : 'Peserta';

            const participantItem = document.createElement('div');
            participantItem.className = 'participant-item';

            const participantName = document.createElement('span');
            participantName.className = 'participant-name';
            participantName.textContent = employeeName;

            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.className = 'btn-remove-participant';
            removeButton.textContent = 'Hapus';
            removeButton.onclick = function() {
                removeParticipant(employeeId);
            };

            participantItem.appendChild(participantName);
            participantItem.appendChild(removeButton);

            participantList.appendChild(participantItem);
        });

        participantIdsInput.value = selectedParticipants.join(',');
    }

    // =========================================================
    // CUSTOM TIME PICKER
    // =========================================================

    const timePickerState = {
        target: null,
        selectedHour: '09',
        selectedMinute: '00'
    };

    function padTwoDigits(value) {
        return String(value).padStart(2, '0');
    }

    function splitTime(timeValue) {
        const parts = String(timeValue || '00:00').split(':');

        return {
            hour: parts[0] || '00',
            minute: parts[1] || '00'
        };
    }

    function timeToMinutes(timeValue) {
        if (!timeValue) {
            return null;
        }

        const parts = String(timeValue).split(':');
        const hour = parseInt(parts[0], 10);
        const minute = parseInt(parts[1], 10);

        return hour * 60 + minute;
    }

    function minutesToTime(totalMinutes) {
        const safeMinutes = Math.max(0, Math.min(totalMinutes, 23 * 60 + 59));
        const hour = Math.floor(safeMinutes / 60);
        const minute = safeMinutes % 60;

        return padTwoDigits(hour) + ':' + padTwoDigits(minute);
    }

    function getDefaultEndTimeFromStart() {
        const startTime = document.getElementById('start_time').value || '09:00';
        const startMinutes = timeToMinutes(startTime);

        if (startMinutes === null) {
            return '11:00';
        }

        return minutesToTime(Math.min(startMinutes + 60, 23 * 60 + 59));
    }

    function getCurrentTargetTime() {
        if (timePickerState.target === 'start') {
            return document.getElementById('start_time').value || '09:00';
        }

        return document.getElementById('end_time').value || getDefaultEndTimeFromStart();
    }

    function setTimeValue(target, timeValue) {
        const startTimeInput = document.getElementById('start_time');
        const endTimeInput = document.getElementById('end_time');
        const startDisplay = document.getElementById('start_time_display');
        const endDisplay = document.getElementById('end_time_display');

        if (target === 'start') {
            startTimeInput.value = timeValue;
            startDisplay.value = timeValue;

            /*
                Kalau waktu mulai diubah dan waktu selesai lama jadi tidak valid,
                waktu selesai otomatis dibuat 1 jam setelah waktu mulai.
            */
            if (
                endTimeInput.value &&
                timeToMinutes(endTimeInput.value) <= timeToMinutes(timeValue)
            ) {
                const newEndTime = getDefaultEndTimeFromStart();
                endTimeInput.value = newEndTime;
                endDisplay.value = newEndTime;
            }
        }

        if (target === 'end') {
            const startTime = startTimeInput.value;

            if (timeToMinutes(timeValue) <= timeToMinutes(startTime)) {
                alert('Waktu selesai harus lebih besar dari waktu mulai.');
                return;
            }

            endTimeInput.value = timeValue;
            endDisplay.value = timeValue;
        }
    }

    function renderTimeOptions() {
        const hourOptions = document.getElementById('hourOptions');
        const minuteOptions = document.getElementById('minuteOptions');

        hourOptions.innerHTML = '';
        minuteOptions.innerHTML = '';

        for (let hour = 0; hour <= 23; hour++) {
            const value = padTwoDigits(hour);
            const button = document.createElement('button');

            button.type = 'button';
            button.className = 'time-option';
            button.textContent = value;

            if (value === timePickerState.selectedHour) {
                button.classList.add('active');
            }

            button.addEventListener('click', function() {
                timePickerState.selectedHour = value;
                renderTimeOptions();
                applySelectedTime();
            });

            hourOptions.appendChild(button);
        }

        for (let minute = 0; minute <= 59; minute++) {
            const value = padTwoDigits(minute);
            const button = document.createElement('button');

            button.type = 'button';
            button.className = 'time-option';
            button.textContent = value;

            if (value === timePickerState.selectedMinute) {
                button.classList.add('active');
            }

            button.addEventListener('click', function() {
                timePickerState.selectedMinute = value;
                renderTimeOptions();
                applySelectedTime();
            });

            minuteOptions.appendChild(button);
        }
    }

    function applySelectedTime() {
        if (!timePickerState.target) {
            return;
        }

        const timeValue = timePickerState.selectedHour + ':' + timePickerState.selectedMinute;
        setTimeValue(timePickerState.target, timeValue);
    }

    function openTimePicker(target, inputElement) {
        const panel = document.getElementById('timePickerPanel');
        const title = document.getElementById('timePickerTitle');
        const note = document.getElementById('timePickerNote');

        timePickerState.target = target;

        const currentTime = getCurrentTargetTime();
        const timeParts = splitTime(currentTime);

        timePickerState.selectedHour = timeParts.hour;
        timePickerState.selectedMinute = timeParts.minute;

        title.textContent = target === 'start' ? 'Pilih Waktu Mulai' : 'Pilih Waktu Selesai';

        note.textContent =
            target === 'start'
                ? 'Pilih jam dan menit mulai rapat.'
                : 'Pilih jam dan menit selesai rapat. Waktu selesai harus lebih besar dari waktu mulai.';

        renderTimeOptions();

        const rect = inputElement.getBoundingClientRect();

        panel.style.left = rect.left + 'px';
        panel.style.top = (rect.bottom + 8) + 'px';

        const panelWidth = 320;

        if (rect.left + panelWidth > window.innerWidth - 16) {
            panel.style.left = (window.innerWidth - panelWidth - 16) + 'px';
        }

        const panelHeightEstimate = 320;

        if (rect.bottom + panelHeightEstimate > window.innerHeight) {
            panel.style.top = Math.max(16, rect.top - panelHeightEstimate - 8) + 'px';
        }

        panel.classList.add('active');
    }

    function closeTimePicker() {
        const panel = document.getElementById('timePickerPanel');

        panel.classList.remove('active');
        timePickerState.target = null;
    }

    function initializeTimePicker() {
        const startDisplay = document.getElementById('start_time_display');
        const endDisplay = document.getElementById('end_time_display');
        const meetingForm = document.querySelector('.meeting-form');

        startDisplay.addEventListener('click', function() {
            openTimePicker('start', startDisplay);
        });

        startDisplay.addEventListener('focus', function() {
            openTimePicker('start', startDisplay);
        });

        endDisplay.addEventListener('click', function() {
            openTimePicker('end', endDisplay);
        });

        endDisplay.addEventListener('focus', function() {
            openTimePicker('end', endDisplay);
        });

        document.addEventListener('click', function(event) {
            const panel = document.getElementById('timePickerPanel');

            const clickedInsidePanel = panel.contains(event.target);
            const clickedStartInput = startDisplay.contains(event.target);
            const clickedEndInput = endDisplay.contains(event.target);

            if (!clickedInsidePanel && !clickedStartInput && !clickedEndInput) {
                closeTimePicker();
            }
        });

        meetingForm.addEventListener('submit', function(event) {
            const startTime = document.getElementById('start_time').value;
            const endTime = document.getElementById('end_time').value;

            if (!startTime) {
                event.preventDefault();
                alert('Waktu mulai wajib diisi.');
                return;
            }

            if (!endTime) {
                event.preventDefault();
                alert('Waktu selesai wajib diisi.');
                return;
            }

            if (timeToMinutes(endTime) <= timeToMinutes(startTime)) {
                event.preventDefault();
                alert('Waktu selesai harus lebih besar dari waktu mulai.');
            }
        });
    }

    initializeTimePicker();
</script>

<%- include('../partials/footer') %>