<%- include('../partials/header') %>

<%
  /*
    ==========================================================================
    PERSIAPAN DATA UNTUK FORM EDIT
    ==========================================================================

    meeting_date dari database bisa berupa Date object atau string.
    Input type="date" butuh format YYYY-MM-DD.

    start_time dan end_time dari database biasanya formatnya 09:00:00.
    Untuk tampilan form cukup ambil 09:00.
  */

  const meetingDateValue = meeting.meeting_date
    ? (meeting.meeting_date.toISOString
      ? meeting.meeting_date.toISOString().slice(0, 10)
      : String(meeting.meeting_date).slice(0, 10))
    : '';

  const meetingStartTime = meeting.start_time
    ? String(meeting.start_time).substring(0, 5)
    : '09:00';

  const meetingEndTime = meeting.end_time
    ? String(meeting.end_time).substring(0, 5)
    : '11:00';
%>

<style>
  /*
    Halaman edit meeting dibuat seperti modal di atas halaman detail.
    Opsi "Sampai Selesai" sudah dihapus, karena database asli mewajibkan end_time terisi.
  */

  body {
    overflow: hidden;
  }

  .edit-page-background {
    height: 100vh;
    background: #0c0c0e;
    color: #ffffff;
    overflow: hidden;
  }

  .edit-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px 16px;
    background: rgba(0, 0, 0, 0.65);
    overflow: hidden;
  }

  .edit-modal {
    width: 100%;
    max-width: 640px;
    max-height: calc(100vh - 48px);
    background: #ffffff;
    color: #222222;
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .edit-modal-header {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 28px;
    border-bottom: 1px solid #e5e5e5;
    background: #ffffff;
  }

  .edit-modal-header h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: #222222;
  }

  .edit-close {
    text-decoration: none;
    font-size: 28px;
    color: #777777;
    line-height: 1;
  }

  .edit-close:hover {
    color: #222222;
  }

  .edit-form {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .edit-form-body {
    padding: 24px 28px;
    overflow-y: auto;
    min-height: 0;
  }

  .edit-form-actions {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    padding: 18px 28px;
    border-top: 1px solid #e5e5e5;
    background: #ffffff;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #222222;
  }

  .form-control {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    font-size: 14px;
    color: #222222;
    outline: none;
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .form-control:focus {
    border-color: #2f6f4e;
    box-shadow: 0 0 0 2px rgba(47, 111, 78, 0.12);
  }

  textarea.form-control {
    resize: vertical;
    min-height: 90px;
  }

  /*
    CUSTOM TIME PICKER

    User memilih jam dan menit dari panel custom.
    Tidak ada opsi "Sampai Selesai".
    Waktu selesai wajib lebih besar dari waktu mulai.
  */

  .time-range-control {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
  }

  .time-input-wrapper {
    position: relative;
  }

  .time-display-input {
    width: 100%;
    padding: 12px 42px 12px 14px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    font-size: 14px;
    color: #222222;
    outline: none;
    box-sizing: border-box;
    background-color: #ffffff;
    cursor: pointer;
  }

  .time-display-input:focus {
    border-color: #2f6f4e;
    box-shadow: 0 0 0 2px rgba(47, 111, 78, 0.12);
  }

  .time-icon {
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    color: #666666;
    pointer-events: none;
  }

  .time-range-separator {
    font-weight: 700;
    color: #777777;
  }

  .time-picker-panel {
    position: fixed;
    z-index: 10000;
    width: 320px;
    max-width: calc(100vw - 32px);
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.20);
    padding: 14px;
    display: none;
  }

  .time-picker-panel.active {
    display: block;
  }

  .time-picker-title {
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 700;
    color: #333333;
  }

  .time-picker-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .time-column {
    max-height: 185px;
    overflow-y: auto;
    border: 1px solid #eeeeee;
    border-radius: 9px;
    padding: 6px;
  }

  .time-column-label {
    position: sticky;
    top: 0;
    background: #ffffff;
    padding: 4px 6px 8px;
    font-size: 11px;
    font-weight: 700;
    color: #777777;
    z-index: 1;
  }

  .time-option {
    width: 100%;
    border: none;
    background: transparent;
    padding: 9px 8px;
    border-radius: 7px;
    font-size: 14px;
    color: #222222;
    cursor: pointer;
    text-align: center;
  }

  .time-option:hover {
    background: #f3f4f6;
  }

  .time-option.active {
    background: #2f6f4e;
    color: #ffffff;
    font-weight: 700;
  }

  .time-picker-note {
    margin-top: 8px;
    font-size: 12px;
    color: #777777;
    line-height: 1.4;
  }

  .participant-input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  .btn-add-participant {
    padding: 0 18px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    background: #ffffff;
    color: #222222;
    font-size: 14px;
    cursor: pointer;
  }

  .btn-add-participant:hover {
    background: #f5f5f5;
  }

  .participant-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .participant-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: #f8f8f8;
    font-size: 14px;
  }

  .participant-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .participant-avatar {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: #dcfce7;
    color: #15803d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }

  .participant-text {
    min-width: 0;
  }

  .participant-name {
    color: #222222;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .participant-number {
    color: #888888;
    font-size: 12px;
    margin-top: 2px;
  }

  .btn-remove-participant {
    border: none;
    background: transparent;
    color: #b42318;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .empty-participant-text {
    margin-top: 10px;
    font-size: 13px;
    color: #777777;
  }

  .btn-cancel {
    padding: 11px 18px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    background: #ffffff;
    color: #222222;
    text-decoration: none;
    font-size: 14px;
    cursor: pointer;
  }

  .btn-save {
    padding: 11px 18px;
    border: none;
    border-radius: 9px;
    background: #2f6f4e;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-cancel:hover {
    background: #f5f5f5;
  }

  .btn-save:hover {
    background: #285f43;
  }



  .external-participant-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    gap: 10px;
    align-items: center;
  }

  .external-participant-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .external-participant-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: #f8f8f8;
    font-size: 14px;
  }

  .external-participant-info {
    min-width: 0;
  }

  .external-participant-name {
    color: #222222;
    font-weight: 700;
  }

  .external-participant-detail {
    color: #888888;
    font-size: 12px;
    margin-top: 2px;
  }

  @media (max-width: 640px) {
    .edit-backdrop {
      align-items: flex-start;
      padding: 16px 12px;
    }

    .edit-modal {
      max-height: calc(100vh - 32px);
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .time-range-control {
      grid-template-columns: 1fr;
    }

    .time-range-separator {
      display: none;
    }

    .participant-input-row,
    .external-participant-grid {
      grid-template-columns: 1fr;
    }

    .edit-form-actions {
      flex-direction: column-reverse;
      align-items: stretch;
      padding: 16px 20px;
    }

    .btn-cancel,
    .btn-save {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="edit-page-background">
  <div class="p-4 md:p-6 xl:p-8">
    <div class="max-w-5xl mx-auto">
      <div class="mb-6">
        <a
          href="/meetings"
          class="inline-flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-semibold"
        >
          <span class="text-xl leading-none">←</span>
          <span>Kembali ke Daftar Meeting</span>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">
            Detail Meeting
          </h1>

          <p class="text-zinc-400 text-sm mt-1">
            Informasi meeting yang sedang diedit.
          </p>
        </div>
      </div>

      <div class="bg-white text-zinc-900 rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-zinc-200">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="capitalize px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                  <%= meeting.status %>
                </span>

                <span class="capitalize px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                  <%= meeting.meeting_type %>
                </span>
              </div>

              <h2 class="text-2xl md:text-3xl font-bold text-zinc-900">
                <%= meeting.title %>
              </h2>

              <p class="text-zinc-500 mt-3 leading-relaxed">
                <%= meeting.description || 'Tidak ada deskripsi atau agenda untuk meeting ini.' %>
              </p>
            </div>

            <div class="w-20 h-20 rounded-2xl bg-emerald-50 flex flex-col items-center justify-center shrink-0">
              <div class="text-xs font-bold text-zinc-400 uppercase">
                <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { month: 'short' }) %>
              </div>

              <div class="text-3xl font-black text-emerald-700 leading-none">
                <%= new Date(meeting.meeting_date).getDate() %>
              </div>
            </div>
          </div>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-4 gap-4">
          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Tanggal</p>
            <p class="font-bold text-zinc-900">
              <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Waktu Meeting</p>
            <p class="font-bold text-zinc-900">
              <%= meetingStartTime %> - <%= meetingEndTime %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Tipe</p>
            <p class="capitalize font-bold text-zinc-900">
              <%= meeting.meeting_type %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Lokasi / Link</p>
            <p class="font-bold text-zinc-900">
              <%= meeting.online_link || '-' %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="edit-backdrop">
    <div class="edit-modal">
      <div class="edit-modal-header">
        <h1>Edit Meeting</h1>

        <a href="/meetings/<%= meeting.id %>" class="edit-close">
          &times;
        </a>
      </div>

      <form action="/meetings/<%= meeting.id %>/edit" method="POST" class="edit-form">
        <div class="edit-form-body">
          <div class="form-group">
            <label for="title">Judul Meeting *</label>

            <input
              type="text"
              id="title"
              name="title"
              class="form-control"
              value="<%= meeting.title %>"
              required
            >
          </div>

          <div class="form-group">
            <label for="description">Deskripsi / Agenda</label>

            <textarea
              id="description"
              name="description"
              class="form-control"
              rows="4"
            ><%= meeting.description || '' %></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="meeting_date">Tanggal *</label>

              <input
                type="date"
                id="meeting_date"
                name="meeting_date"
                class="form-control"
                value="<%= meetingDateValue %>"
                onclick="this.showPicker && this.showPicker()"
                onfocus="this.showPicker && this.showPicker()"
                required
              >
            </div>

            <div class="form-group">
              <label>Waktu Meeting *</label>

              <div class="time-range-control">
                <div class="time-input-wrapper">
                  <input
                    type="text"
                    id="start_time_display"
                    class="time-display-input"
                    value="<%= meetingStartTime %>"
                    readonly
                    data-picker-target="start"
                  >
                  <span class="time-icon">◷</span>
                </div>

                <span class="time-range-separator">-</span>

                <div class="time-input-wrapper">
                  <input
                    type="text"
                    id="end_time_display"
                    class="time-display-input"
                    value="<%= meetingEndTime %>"
                    readonly
                    data-picker-target="end"
                  >
                  <span class="time-icon">◷</span>
                </div>
              </div>

              <!--
                Input hidden ini yang dikirim ke controller.
                Database asli mewajibkan start_time dan end_time terisi.
              -->
              <input type="hidden" id="start_time" name="start_time" value="<%= meetingStartTime %>">
              <input type="hidden" id="end_time" name="end_time" value="<%= meetingEndTime %>">
            </div>
          </div>

          <div class="form-group">
            <label for="status">Status Meeting *</label>

            <select
              id="status"
              name="status"
              class="form-control"
              required
            >
              <option value="draft" <%= meeting.status === 'draft' ? 'selected' : '' %>>
                Draft
              </option>

              <option value="scheduled" <%= meeting.status === 'scheduled' ? 'selected' : '' %>>
                Scheduled
              </option>

              <option value="completed" <%= meeting.status === 'completed' ? 'selected' : '' %>>
                Completed
              </option>

              <option value="cancelled" <%= meeting.status === 'cancelled' ? 'selected' : '' %>>
                Cancelled
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="meeting_type">Tipe Meeting *</label>

            <select
              id="meeting_type"
              name="meeting_type"
              class="form-control"
              required
            >
              <option value="offline" <%= meeting.meeting_type === 'offline' ? 'selected' : '' %>>
                Tatap Muka
              </option>

              <option value="online" <%= meeting.meeting_type === 'online' ? 'selected' : '' %>>
                Online
              </option>

              <option value="hybrid" <%= meeting.meeting_type === 'hybrid' ? 'selected' : '' %>>
                Hybrid
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="online_link">Lokasi / Link Meeting</label>

            <input
              type="text"
              id="online_link"
              name="online_link"
              class="form-control"
              value="<%= meeting.online_link || '' %>"
              placeholder="Ruang rapat / Link Zoom / Google Meet"
            >
          </div>

          <div class="form-group">
            <label for="employee_select">Peserta Meeting</label>

            <div class="participant-input-row">
              <select id="employee_select" class="form-control">
                <option value="">Pilih peserta...</option>

                <% if (typeof employees !== 'undefined' && employees && employees.length > 0) { %>
                  <% employees.forEach(function(employee) { %>
                    <option
                      value="<%= employee.id %>"
                      data-name="<%= employee.name %>"
                      data-number="<%= employee.employee_number || '' %>"
                    >
                      <%= employee.name %>
                      <% if (employee.employee_number) { %>
                        - <%= employee.employee_number %>
                      <% } %>
                    </option>
                  <% }) %>
                <% } %>
              </select>

              <button
                type="button"
                class="btn-add-participant"
                onclick="addParticipant()"
              >
                Tambah
              </button>
            </div>

            <p id="emptyParticipantText" class="empty-participant-text">
              Belum ada peserta yang ditambahkan.
            </p>

            <div id="participantList" class="participant-list"></div>

            <input
              type="hidden"
              id="participant_ids"
              name="participant_ids"
              value=""
            >
          </div>

          <div class="form-group">
            <label>Peserta Eksternal</label>

            <div class="external-participant-grid">
              <input
                type="text"
                id="external_name"
                class="form-control"
                placeholder="Nama peserta eksternal"
              >

              <input
                type="text"
                id="external_institution"
                class="form-control"
                placeholder="Instansi"
              >

              <input
                type="email"
                id="external_email"
                class="form-control"
                placeholder="Email"
              >

              <button
                type="button"
                class="btn-add-participant"
                onclick="addExternalParticipant()"
              >
                Tambah
              </button>
            </div>

            <p id="emptyExternalParticipantText" class="empty-participant-text">
              Belum ada peserta eksternal yang ditambahkan.
            </p>

            <div id="externalParticipantList" class="external-participant-list"></div>

            <input
              type="hidden"
              id="external_participants"
              name="external_participants"
              value="[]"
            >
          </div>
        </div>

        <div class="edit-form-actions">
          <a href="/meetings/<%= meeting.id %>" class="btn-cancel">
            Batal
          </a>

          <button type="submit" class="btn-save">
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<div id="timePickerPanel" class="time-picker-panel">
  <div id="timePickerTitle" class="time-picker-title">
    Pilih Waktu
  </div>

  <div class="time-picker-columns">
    <div class="time-column">
      <div class="time-column-label">Jam</div>
      <div id="hourOptions"></div>
    </div>

    <div class="time-column">
      <div class="time-column-label">Menit</div>
      <div id="minuteOptions"></div>
    </div>
  </div>

  <div id="timePickerNote" class="time-picker-note">
    Pilih jam dan menit.
  </div>
</div>

<script type="application/json" id="selectedParticipantsJson">
  <%- JSON.stringify(selectedParticipantsData || []) %>
</script>

<script type="application/json" id="selectedExternalParticipantsJson">
  <%- JSON.stringify(selectedExternalParticipantsData || []) %>
</script>

<script>
  // =========================================================
  // PESERTA MEETING
  // =========================================================

  const selectedParticipantsJson = document.getElementById('selectedParticipantsJson');

  let selectedParticipants = [];

  try {
    selectedParticipants = JSON.parse(selectedParticipantsJson.textContent || '[]');
  } catch (error) {
    selectedParticipants = [];
  }

  function addParticipant() {
    const employeeSelect = document.getElementById('employee_select');
    const selectedOption = employeeSelect.options[employeeSelect.selectedIndex];

    const employeeId = employeeSelect.value;

    if (!employeeId) {
      alert('Silakan pilih peserta terlebih dahulu.');
      return;
    }

    const employeeName = selectedOption.getAttribute('data-name');
    const employeeNumber = selectedOption.getAttribute('data-number') || '';

    const alreadySelected = selectedParticipants.some(function(participant) {
      return String(participant.id) === String(employeeId);
    });

    if (alreadySelected) {
      alert('Peserta ini sudah ada di daftar meeting.');
      return;
    }

    selectedParticipants.push({
      id: String(employeeId),
      name: employeeName,
      number: employeeNumber
    });

    employeeSelect.value = '';
    renderParticipantList();
  }

  function removeParticipant(employeeId) {
    selectedParticipants = selectedParticipants.filter(function(participant) {
      return String(participant.id) !== String(employeeId);
    });

    renderParticipantList();
  }

  function renderParticipantList() {
    const participantList = document.getElementById('participantList');
    const participantIdsInput = document.getElementById('participant_ids');
    const emptyParticipantText = document.getElementById('emptyParticipantText');

    participantList.innerHTML = '';

    emptyParticipantText.style.display = selectedParticipants.length === 0 ? 'block' : 'none';

    selectedParticipants.forEach(function(participant) {
      const initial = participant.name
        ? participant.name.substring(0, 1).toUpperCase()
        : '?';

      const participantItem = document.createElement('div');
      participantItem.className = 'participant-item';

      participantItem.innerHTML =
        '<div class="participant-info">' +
          '<div class="participant-avatar">' + initial + '</div>' +
          '<div class="participant-text">' +
            '<div class="participant-name">' + participant.name + '</div>' +
            '<div class="participant-number">' + (participant.number || 'Tidak ada nomor pegawai') + '</div>' +
          '</div>' +
        '</div>' +
        '<button type="button" class="btn-remove-participant" onclick="removeParticipant(\'' + participant.id + '\')">Hapus</button>';

      participantList.appendChild(participantItem);
    });

    participantIdsInput.value = selectedParticipants.map(function(participant) {
      return participant.id;
    }).join(',');

    updateParticipantDropdown();
  }

  function updateParticipantDropdown() {
    const employeeSelect = document.getElementById('employee_select');

    if (!employeeSelect) {
      return;
    }

    const selectedIds = selectedParticipants.map(function(participant) {
      return String(participant.id);
    });

    Array.from(employeeSelect.options).forEach(function(option) {
      if (!option.value) {
        return;
      }

      if (selectedIds.includes(String(option.value))) {
        option.disabled = true;
        option.hidden = true;
      } else {
        option.disabled = false;
        option.hidden = false;
      }
    });
  }

  // =========================================================
  // PESERTA EKSTERNAL
  // =========================================================

  const selectedExternalParticipantsJson = document.getElementById('selectedExternalParticipantsJson');

  let selectedExternalParticipants = [];

  try {
    selectedExternalParticipants = JSON.parse(selectedExternalParticipantsJson.textContent || '[]');
  } catch (error) {
    selectedExternalParticipants = [];
  }

  function addExternalParticipant() {
    const nameInput = document.getElementById('external_name');
    const institutionInput = document.getElementById('external_institution');
    const emailInput = document.getElementById('external_email');

    const name = nameInput.value.trim();
    const institution = institutionInput.value.trim();
    const email = emailInput.value.trim();

    if (!name) {
      alert('Nama peserta eksternal wajib diisi.');
      return;
    }

    const alreadySelected = selectedExternalParticipants.some(function(participant) {
      return String(participant.name || '').toLowerCase() === name.toLowerCase() &&
        String(participant.email || '').toLowerCase() === email.toLowerCase();
    });

    if (alreadySelected) {
      alert('Peserta eksternal ini sudah ditambahkan.');
      return;
    }

    selectedExternalParticipants.push({
      name: name,
      institution: institution,
      email: email,
      status: 'invited'
    });

    nameInput.value = '';
    institutionInput.value = '';
    emailInput.value = '';

    renderExternalParticipantList();
  }

  function removeExternalParticipant(index) {
    selectedExternalParticipants.splice(index, 1);
    renderExternalParticipantList();
  }

  function renderExternalParticipantList() {
    const externalParticipantList = document.getElementById('externalParticipantList');
    const externalParticipantsInput = document.getElementById('external_participants');
    const emptyExternalParticipantText = document.getElementById('emptyExternalParticipantText');

    externalParticipantList.innerHTML = '';
    emptyExternalParticipantText.style.display = selectedExternalParticipants.length === 0 ? 'block' : 'none';

    selectedExternalParticipants.forEach(function(participant, index) {
      const detailParts = [];

      if (participant.institution) {
        detailParts.push(participant.institution);
      }

      if (participant.email) {
        detailParts.push(participant.email);
      }

      const participantItem = document.createElement('div');
      participantItem.className = 'external-participant-item';

      participantItem.innerHTML =
        '<div class="external-participant-info">' +
          '<div class="external-participant-name">' + participant.name + '</div>' +
          '<div class="external-participant-detail">' + (detailParts.join(' • ') || 'Peserta eksternal') + '</div>' +
        '</div>' +
        '<button type="button" class="btn-remove-participant" onclick="removeExternalParticipant(' + index + ')">Hapus</button>';

      externalParticipantList.appendChild(participantItem);
    });

    externalParticipantsInput.value = JSON.stringify(selectedExternalParticipants);
  }

  // =========================================================
  // CUSTOM TIME PICKER
  // =========================================================

  const timePickerState = {
    target: null,
    selectedHour: '09',
    selectedMinute: '00'
  };

  function padTwoDigits(value) {
    return String(value).padStart(2, '0');
  }

  function splitTime(timeValue) {
    const parts = String(timeValue || '00:00').split(':');

    return {
      hour: parts[0] || '00',
      minute: parts[1] || '00'
    };
  }

  function timeToMinutes(timeValue) {
    if (!timeValue) {
      return null;
    }

    const parts = String(timeValue).split(':');
    const hour = parseInt(parts[0], 10);
    const minute = parseInt(parts[1], 10);

    return hour * 60 + minute;
  }

  function minutesToTime(totalMinutes) {
    const safeMinutes = Math.max(0, Math.min(totalMinutes, 23 * 60 + 59));
    const hour = Math.floor(safeMinutes / 60);
    const minute = safeMinutes % 60;

    return padTwoDigits(hour) + ':' + padTwoDigits(minute);
  }

  function getDefaultEndTimeFromStart() {
    const startTime = document.getElementById('start_time').value || '09:00';
    const startMinutes = timeToMinutes(startTime);

    if (startMinutes === null) {
      return '11:00';
    }

    return minutesToTime(Math.min(startMinutes + 60, 23 * 60 + 59));
  }

  function getCurrentTargetTime() {
    if (timePickerState.target === 'start') {
      return document.getElementById('start_time').value || '09:00';
    }

    return document.getElementById('end_time').value || getDefaultEndTimeFromStart();
  }

  function setTimeValue(target, timeValue) {
    const startTimeInput = document.getElementById('start_time');
    const endTimeInput = document.getElementById('end_time');
    const startDisplay = document.getElementById('start_time_display');
    const endDisplay = document.getElementById('end_time_display');

    if (target === 'start') {
      startTimeInput.value = timeValue;
      startDisplay.value = timeValue;

      /*
        Kalau waktu mulai diubah dan waktu selesai lama jadi tidak valid,
        waktu selesai otomatis dibuat 1 jam setelah waktu mulai.
      */
      if (
        endTimeInput.value &&
        timeToMinutes(endTimeInput.value) <= timeToMinutes(timeValue)
      ) {
        const newEndTime = getDefaultEndTimeFromStart();
        endTimeInput.value = newEndTime;
        endDisplay.value = newEndTime;
      }
    }

    if (target === 'end') {
      const startTime = startTimeInput.value;

      if (timeToMinutes(timeValue) <= timeToMinutes(startTime)) {
        alert('Waktu selesai harus lebih besar dari waktu mulai.');
        return;
      }

      endTimeInput.value = timeValue;
      endDisplay.value = timeValue;
    }
  }

  function renderTimeOptions() {
    const hourOptions = document.getElementById('hourOptions');
    const minuteOptions = document.getElementById('minuteOptions');

    hourOptions.innerHTML = '';
    minuteOptions.innerHTML = '';

    for (let hour = 0; hour <= 23; hour++) {
      const value = padTwoDigits(hour);
      const button = document.createElement('button');

      button.type = 'button';
      button.className = 'time-option';
      button.textContent = value;

      if (value === timePickerState.selectedHour) {
        button.classList.add('active');
      }

      button.addEventListener('click', function() {
        timePickerState.selectedHour = value;
        renderTimeOptions();
        applySelectedTime();
      });

      hourOptions.appendChild(button);
    }

    for (let minute = 0; minute <= 59; minute++) {
      const value = padTwoDigits(minute);
      const button = document.createElement('button');

      button.type = 'button';
      button.className = 'time-option';
      button.textContent = value;

      if (value === timePickerState.selectedMinute) {
        button.classList.add('active');
      }

      button.addEventListener('click', function() {
        timePickerState.selectedMinute = value;
        renderTimeOptions();
        applySelectedTime();
      });

      minuteOptions.appendChild(button);
    }
  }

  function applySelectedTime() {
    if (!timePickerState.target) {
      return;
    }

    const timeValue = timePickerState.selectedHour + ':' + timePickerState.selectedMinute;
    setTimeValue(timePickerState.target, timeValue);
  }

  function openTimePicker(target, inputElement) {
    const panel = document.getElementById('timePickerPanel');
    const title = document.getElementById('timePickerTitle');
    const note = document.getElementById('timePickerNote');

    timePickerState.target = target;

    const currentTime = getCurrentTargetTime();
    const timeParts = splitTime(currentTime);

    timePickerState.selectedHour = timeParts.hour;
    timePickerState.selectedMinute = timeParts.minute;

    title.textContent = target === 'start' ? 'Pilih Waktu Mulai' : 'Pilih Waktu Selesai';

    note.textContent =
      target === 'start'
        ? 'Pilih jam dan menit mulai rapat.'
        : 'Pilih jam dan menit selesai rapat. Waktu selesai harus lebih besar dari waktu mulai.';

    renderTimeOptions();

    const rect = inputElement.getBoundingClientRect();

    panel.style.left = rect.left + 'px';
    panel.style.top = (rect.bottom + 8) + 'px';

    const panelWidth = 320;

    if (rect.left + panelWidth > window.innerWidth - 16) {
      panel.style.left = (window.innerWidth - panelWidth - 16) + 'px';
    }

    const panelHeightEstimate = 320;

    if (rect.bottom + panelHeightEstimate > window.innerHeight) {
      panel.style.top = Math.max(16, rect.top - panelHeightEstimate - 8) + 'px';
    }

    panel.classList.add('active');
  }

  function closeTimePicker() {
    const panel = document.getElementById('timePickerPanel');

    panel.classList.remove('active');
    timePickerState.target = null;
  }

  function initializeTimePicker() {
    const startDisplay = document.getElementById('start_time_display');
    const endDisplay = document.getElementById('end_time_display');
    const editForm = document.querySelector('.edit-form');

    startDisplay.addEventListener('click', function() {
      openTimePicker('start', startDisplay);
    });

    startDisplay.addEventListener('focus', function() {
      openTimePicker('start', startDisplay);
    });

    endDisplay.addEventListener('click', function() {
      openTimePicker('end', endDisplay);
    });

    endDisplay.addEventListener('focus', function() {
      openTimePicker('end', endDisplay);
    });

    document.addEventListener('click', function(event) {
      const panel = document.getElementById('timePickerPanel');

      const clickedInsidePanel = panel.contains(event.target);
      const clickedStartInput = startDisplay.contains(event.target);
      const clickedEndInput = endDisplay.contains(event.target);

      if (!clickedInsidePanel && !clickedStartInput && !clickedEndInput) {
        closeTimePicker();
      }
    });

    editForm.addEventListener('submit', function(event) {
      const startTime = document.getElementById('start_time').value;
      const endTime = document.getElementById('end_time').value;

      if (!startTime) {
        event.preventDefault();
        alert('Waktu mulai wajib diisi.');
        return;
      }

      if (!endTime) {
        event.preventDefault();
        alert('Waktu selesai wajib diisi.');
        return;
      }

      if (timeToMinutes(endTime) <= timeToMinutes(startTime)) {
        event.preventDefault();
        alert('Waktu selesai harus lebih besar dari waktu mulai.');
      }
    });
  }

  renderParticipantList();
  renderExternalParticipantList();
  initializeTimePicker();
</script>

