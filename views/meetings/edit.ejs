<%- include('../partials/header') %>

<style>
  body {
    overflow: hidden;
  }

  .edit-page-background {
    height: 100vh;
    background: #0c0c0e;
    color: #ffffff;
    overflow: hidden;
  }

  .edit-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 24px 16px;
    background: rgba(0, 0, 0, 0.65);
    overflow: hidden;
  }

  .edit-modal {
    width: 100%;
    max-width: 640px;
    max-height: calc(100vh - 48px);
    background: #ffffff;
    color: #222222;
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .edit-modal-header {
    flex-shrink: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 28px;
    border-bottom: 1px solid #e5e5e5;
    background: #ffffff;
  }

  .edit-modal-header h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: #222222;
  }

  .edit-close {
    text-decoration: none;
    font-size: 28px;
    color: #777777;
    line-height: 1;
  }

  .edit-close:hover {
    color: #222222;
  }

  .edit-form {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  .edit-form-body {
    padding: 24px 28px;
    overflow-y: auto;
    min-height: 0;
  }

  .edit-form-actions {
    flex-shrink: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    padding: 18px 28px;
    border-top: 1px solid #e5e5e5;
    background: #ffffff;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #222222;
  }

  .form-control {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    font-size: 14px;
    color: #222222;
    outline: none;
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .form-control:focus {
    border-color: #2f6f4e;
    box-shadow: 0 0 0 2px rgba(47, 111, 78, 0.12);
  }

  textarea.form-control {
    resize: vertical;
    min-height: 90px;
  }

  .participant-input-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
  }

  .btn-add-participant {
    padding: 0 18px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    background: #ffffff;
    color: #222222;
    font-size: 14px;
    cursor: pointer;
  }

  .btn-add-participant:hover {
    background: #f5f5f5;
  }

  .participant-list {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .participant-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border: 1px solid #e2e2e2;
    border-radius: 10px;
    background: #f8f8f8;
    font-size: 14px;
  }

  .participant-info {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .participant-avatar {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: #dcfce7;
    color: #15803d;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }

  .participant-text {
    min-width: 0;
  }

  .participant-name {
    color: #222222;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .participant-number {
    color: #888888;
    font-size: 12px;
    margin-top: 2px;
  }

  .btn-remove-participant {
    border: none;
    background: transparent;
    color: #b42318;
    font-size: 13px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .empty-participant-text {
    margin-top: 10px;
    font-size: 13px;
    color: #777777;
  }

  .btn-cancel {
    padding: 11px 18px;
    border: 1px solid #d0d0d0;
    border-radius: 9px;
    background: #ffffff;
    color: #222222;
    text-decoration: none;
    font-size: 14px;
    cursor: pointer;
  }

  .btn-save {
    padding: 11px 18px;
    border: none;
    border-radius: 9px;
    background: #2f6f4e;
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-cancel:hover {
    background: #f5f5f5;
  }

  .btn-save:hover {
    background: #285f43;
  }

  @media (max-width: 640px) {
    .edit-backdrop {
      align-items: flex-start;
      padding: 16px 12px;
    }

    .edit-modal {
      max-height: calc(100vh - 32px);
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .participant-input-row {
      grid-template-columns: 1fr;
    }

    .edit-form-actions {
      flex-direction: column-reverse;
      align-items: stretch;
      padding: 16px 20px;
    }

    .btn-cancel,
    .btn-save {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="edit-page-background">

  <div class="p-4 md:p-6 xl:p-8">
    <div class="max-w-5xl mx-auto">

      <div class="mb-6">
        <a
          href="/meetings"
          class="inline-flex items-center gap-2 text-zinc-400 hover:text-white transition-colors text-sm font-semibold"
        >
          <span class="text-xl leading-none">←</span>
          <span>Kembali ke Daftar Meeting</span>
        </a>
      </div>

      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">
            Detail Meeting
          </h1>

          <p class="text-zinc-400 text-sm mt-1">
            Informasi meeting yang sedang diedit.
          </p>
        </div>
      </div>

      <div class="bg-white text-zinc-900 rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">

        <div class="p-6 border-b border-zinc-200">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">

            <div>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="capitalize px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
                  <%= meeting.status %>
                </span>

                <span class="capitalize px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-xs font-semibold">
                  <%= meeting.meeting_type %>
                </span>
              </div>

              <h2 class="text-2xl md:text-3xl font-bold text-zinc-900">
                <%= meeting.title %>
              </h2>

              <p class="text-zinc-500 mt-3 leading-relaxed">
                <%= meeting.description || 'Tidak ada deskripsi atau agenda untuk meeting ini.' %>
              </p>
            </div>

            <div class="w-20 h-20 rounded-2xl bg-emerald-50 flex flex-col items-center justify-center shrink-0">
              <div class="text-xs font-bold text-zinc-400 uppercase">
                <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { month: 'short' }) %>
              </div>

              <div class="text-3xl font-black text-emerald-700 leading-none">
                <%= new Date(meeting.meeting_date).getDate() %>
              </div>
            </div>

          </div>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-4 gap-4">

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Tanggal</p>
            <p class="font-bold text-zinc-900">
              <%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Waktu Mulai</p>
            <p class="font-bold text-zinc-900">
              <%= meeting.start_time.substring(0,5) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Waktu Selesai</p>
            <p class="font-bold text-zinc-900">
              <%= meeting.end_time.substring(0,5) %>
            </p>
          </div>

          <div class="rounded-xl border border-zinc-200 p-4 bg-zinc-50">
            <p class="text-xs font-bold text-zinc-400 uppercase mb-1">Tipe</p>
            <p class="capitalize font-bold text-zinc-900">
              <%= meeting.meeting_type %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="edit-backdrop">
    <div class="edit-modal">

      <div class="edit-modal-header">
        <h1>Edit Meeting</h1>

        <a href="/meetings/<%= meeting.id %>" class="edit-close">
          &times;
        </a>
      </div>

      <form action="/meetings/<%= meeting.id %>/edit" method="POST" class="edit-form">

        <div class="edit-form-body">

          <div class="form-group">
            <label for="title">Judul Meeting *</label>

            <input
              type="text"
              id="title"
              name="title"
              class="form-control"
              value="<%= meeting.title %>"
              required
            >
          </div>

          <div class="form-group">
            <label for="description">Deskripsi / Agenda</label>

            <textarea
              id="description"
              name="description"
              class="form-control"
              rows="4"
            ><%= meeting.description || '' %></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="meeting_date">Tanggal *</label>

              <input
                type="date"
                id="meeting_date"
                name="meeting_date"
                class="form-control"
                value="<%= meeting.meeting_date.toISOString ? meeting.meeting_date.toISOString().slice(0,10) : meeting.meeting_date %>"
                onclick="this.showPicker && this.showPicker()"
                onfocus="this.showPicker && this.showPicker()"
                required
              >
            </div>

            <div class="form-group">
              <label for="start_time">Waktu Mulai *</label>

              <input
                type="time"
                id="start_time"
                name="start_time"
                class="form-control"
                value="<%= meeting.start_time ? String(meeting.start_time).substring(0,5) : '' %>"
                onclick="this.showPicker && this.showPicker()"
                onfocus="this.showPicker && this.showPicker()"
                required
              >
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="end_time">Waktu Selesai *</label>

              <input
                type="time"
                id="end_time"
                name="end_time"
                class="form-control"
                value="<%= meeting.end_time ? String(meeting.end_time).substring(0,5) : '' %>"
                onclick="this.showPicker && this.showPicker()"
                onfocus="this.showPicker && this.showPicker()"
                required
              >
            </div>

            <div class="form-group">
              <label for="meeting_type">Tipe Meeting *</label>

              <select
                id="meeting_type"
                name="meeting_type"
                class="form-control"
                required
              >
                <option value="offline" <%= meeting.meeting_type === 'offline' ? 'selected' : '' %>>
                  Tatap Muka
                </option>

                <option value="online" <%= meeting.meeting_type === 'online' ? 'selected' : '' %>>
                  Online
                </option>

                <option value="hybrid" <%= meeting.meeting_type === 'hybrid' ? 'selected' : '' %>>
                  Hybrid
                </option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="status">Status Meeting *</label>

            <select
              id="status"
              name="status"
              class="form-control"
              required
            >
              <option value="draft" <%= meeting.status === 'draft' ? 'selected' : '' %>>
                Draft
              </option>

              <option value="scheduled" <%= meeting.status === 'scheduled' ? 'selected' : '' %>>
                Scheduled
              </option>

              <option value="completed" <%= meeting.status === 'completed' ? 'selected' : '' %>>
                Completed
              </option>

              <option value="cancelled" <%= meeting.status === 'cancelled' ? 'selected' : '' %>>
                Cancelled
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="employee_select">Peserta Meeting</label>

            <div class="participant-input-row">
              <select
                id="employee_select"
                class="form-control"
              >
                <option value="">Pilih peserta...</option>

                <% if (typeof employees !== 'undefined' && employees && employees.length > 0) { %>
                  <% employees.forEach(function(employee) { %>
                    <option
                      value="<%= employee.id %>"
                      data-name="<%= employee.name %>"
                      data-number="<%= employee.employee_number || '' %>"
                    >
                      <%= employee.name %>
                      <% if (employee.employee_number) { %>
                        - <%= employee.employee_number %>
                      <% } %>
                    </option>
                  <% }) %>
                <% } %>
              </select>

              <button
                type="button"
                class="btn-add-participant"
                onclick="addParticipant()"
              >
                Tambah
              </button>
            </div>

            <p id="emptyParticipantText" class="empty-participant-text">
              Belum ada peserta yang ditambahkan.
            </p>

            <div id="participantList" class="participant-list"></div>

            <input
              type="hidden"
              id="participant_ids"
              name="participant_ids"
              value=""
            >
          </div>

        </div>

        <div class="edit-form-actions">
          <a href="/meetings/<%= meeting.id %>" class="btn-cancel">
            Batal
          </a>

          <button type="submit" class="btn-save">
            Simpan
          </button>
        </div>

      </form>

    </div>
  </div>

</div>

<script type="application/json" id="selectedParticipantsJson">
  <%- JSON.stringify(selectedParticipantsData || []) %>
</script>

<script>
  // Mengambil data peserta lama dari controller
  const selectedParticipantsJson = document.getElementById('selectedParticipantsJson');

  let selectedParticipants = [];

  try {
    selectedParticipants = JSON.parse(selectedParticipantsJson.textContent || '[]');
  } catch (error) {
    selectedParticipants = [];
  }

  function addParticipant() {
    const employeeSelect = document.getElementById('employee_select');
    const selectedOption = employeeSelect.options[employeeSelect.selectedIndex];

    const employeeId = employeeSelect.value;

    if (!employeeId) {
      alert('Silakan pilih peserta terlebih dahulu.');
      return;
    }

    const employeeName = selectedOption.getAttribute('data-name');
    const employeeNumber = selectedOption.getAttribute('data-number') || '';

    const alreadySelected = selectedParticipants.some(function(participant) {
      return String(participant.id) === String(employeeId);
    });

    if (alreadySelected) {
      alert('Peserta ini sudah ada di daftar meeting.');
      return;
    }

    selectedParticipants.push({
      id: String(employeeId),
      name: employeeName,
      number: employeeNumber
    });

    employeeSelect.value = '';

    renderParticipantList();
  }

  function removeParticipant(employeeId) {
    selectedParticipants = selectedParticipants.filter(function(participant) {
      return String(participant.id) !== String(employeeId);
    });

    renderParticipantList();
  }

  function renderParticipantList() {
    const participantList = document.getElementById('participantList');
    const participantIdsInput = document.getElementById('participant_ids');
    const emptyParticipantText = document.getElementById('emptyParticipantText');

    participantList.innerHTML = '';

    if (selectedParticipants.length === 0) {
      emptyParticipantText.style.display = 'block';
    } else {
      emptyParticipantText.style.display = 'none';
    }

    selectedParticipants.forEach(function(participant) {
      const initial = participant.name
        ? participant.name.substring(0, 1).toUpperCase()
        : '?';

      const participantItem = document.createElement('div');
      participantItem.className = 'participant-item';

      participantItem.innerHTML =
        '<div class="participant-info">' +
          '<div class="participant-avatar">' + initial + '</div>' +
          '<div class="participant-text">' +
            '<div class="participant-name">' + participant.name + '</div>' +
            '<div class="participant-number">' + (participant.number || 'Tidak ada nomor pegawai') + '</div>' +
          '</div>' +
        '</div>' +
        '<button type="button" class="btn-remove-participant" onclick="removeParticipant(\'' + participant.id + '\')">Hapus</button>';

      participantList.appendChild(participantItem);
    });

    // Ini penting: data inilah yang dikirim ke controller update
    participantIdsInput.value = selectedParticipants.map(function(participant) {
      return participant.id;
    }).join(',');

    updateParticipantDropdown();
  }

  function updateParticipantDropdown() {
    const employeeSelect = document.getElementById('employee_select');

    if (!employeeSelect) {
      return;
    }

    const selectedIds = selectedParticipants.map(function(participant) {
      return String(participant.id);
    });

    Array.from(employeeSelect.options).forEach(function(option) {
      if (!option.value) {
        return;
      }

      if (selectedIds.includes(String(option.value))) {
        option.disabled = true;
        option.hidden = true;
      } else {
        option.disabled = false;
        option.hidden = false;
      }
    });
  }

  // Saat halaman edit dibuka:
  // 1. peserta lama langsung tampil
  // 2. hidden input participant_ids langsung terisi
  // 3. dropdown otomatis menyembunyikan peserta yang sudah masuk list
  renderParticipantList();
</script>

<%- include('../partials/footer') %>