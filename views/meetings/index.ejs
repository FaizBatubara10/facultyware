<%- include('../partials/header') %>
  <div class="p-4 md:p-6 xl:p-8 bg-[#0c0c0e] min-h-screen text-white">
    <div class="max-w-screen-2xl mx-auto">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">Daftar Meeting</h1>
          <p class="text-zinc-400 text-sm mt-1">Kelola dan lihat seluruh jadwal rapat terdaftar.</p>
        </div>
        <div>
          <a class="inline-flex items-center justify-center rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-600 transition-colors shadow-sm" href="/meetings/create">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            + Buat Meeting Baru
          </a>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-zinc-200 overflow-hidden shadow-xs">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-zinc-600">
            <thead class="bg-zinc-50 text-xs uppercase tracking-wider text-zinc-500 border-b border-zinc-200">
              <tr>
                <th class="px-6 py-5 font-bold">Nama Rapat</th>
                <th class="px-6 py-5 font-bold">Tanggal & Waktu</th>
                <th class="px-6 py-5 font-bold">Tipe</th>
                <th class="px-6 py-5 font-bold">Status</th>
                <th class="px-6 py-5 font-bold text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100">
              <% if (meetings && meetings.length > 0) { %>
                <% meetings.forEach(meeting => { %>
                  <tr class="hover:bg-zinc-50 transition-colors">
                    
                    <td class="px-6 py-4">
                      <div class="font-bold text-zinc-900 text-base"><%= meeting.title %></div>
                      <div class="text-xs text-zinc-400 mt-1 line-clamp-1"><%= meeting.description || 'Tidak ada deskripsi' %></div>
                    </td>
                    
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="font-bold text-emerald-600"><%= new Date(meeting.meeting_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
                      <div class="text-xs font-semibold text-zinc-500 mt-1 flex items-center gap-1">
                        <svg class="w-3 h-3 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <%= meeting.start_time.substring(0,5) %> - <%= meeting.end_time.substring(0,5) %>
                      </div>
                    </td>
                    
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="capitalize text-xs font-bold text-amber-700 bg-amber-50 px-2.5 py-1.5 rounded-md border border-amber-100">
                        <%= meeting.meeting_type %>
                      </span>
                    </td>
                    
                    <td class="px-6 py-4 whitespace-nowrap">
                      <span class="capitalize font-bold px-3 py-1.5 rounded-full text-xs border border-zinc-200 bg-white text-zinc-600 shadow-sm">
                        <%= meeting.status %>
                      </span>
                    </td>
                    
                    <td class="px-6 py-4 text-right whitespace-nowrap">
                      <a href="/meetings/<%= meeting.id %>/edit" class="inline-flex items-center justify-center px-3 py-1.5 rounded-lg border border-zinc-200 text-zinc-600 hover:text-emerald-700 hover:bg-emerald-50 hover:border-emerald-200 transition-colors font-semibold text-xs">
                        Edit Data
                      </a>
                    </td>

                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="px-6 py-16 text-center">
                    <div class="flex flex-col items-center justify-center text-zinc-400">
                      <svg class="w-12 h-12 mb-3 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                      <p class="font-bold text-lg text-zinc-500">Belum Ada Rapat</p>
                      <p class="text-sm mt-1">Silakan buat jadwal pertemuan baru terlebih dahulu.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
<%- include('../partials/footer') %>