<%- include('../partials/header') %>

<%
  const filterData = typeof filters !== 'undefined' && filters ? filters : { q: '', status: 'all', sort: 'latest' };
  const paginationData = typeof pagination !== 'undefined' && pagination
    ? pagination
    : { page: 1, totalPages: 1, totalItems: 0, limit: 5 };

  function getDateObject(dateValue) {
    const date = new Date(dateValue);
    return isNaN(date.getTime()) ? null : date;
  }

  function getMonthName(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.toLocaleDateString('id-ID', {
      month: 'short'
    }).toUpperCase();
  }

  function getDayNumber(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return String(date.getDate()).padStart(2, '0');
  }

  function formatTime(timeValue) {
    if (!timeValue) {
      return '-';
    }

    return String(timeValue).substring(0, 5);
  }

  function getMeetingTypeLabel(type) {
    if (type === 'online') {
      return 'Online';
    }

    if (type === 'hybrid') {
      return 'Hybrid';
    }

    return 'Ruang Meeting';
  }

  function getMeetingTypeIcon(type) {
    if (type === 'online') {
      return '🌐';
    }

    if (type === 'hybrid') {
      return '🔀';
    }

    return '📍';
  }

  function getStatusLabel(status) {
    if (status === 'scheduled') {
      return 'Scheduled';
    }

    if (status === 'completed') {
      return 'Completed';
    }

    if (status === 'cancelled') {
      return 'Cancelled';
    }

    return 'Draft';
  }

  function getStatusPillClass(status) {
    if (status === 'scheduled') {
      return 'meeting-status-pill meeting-status-scheduled';
    }

    if (status === 'completed') {
      return 'meeting-status-pill meeting-status-completed';
    }

    if (status === 'cancelled') {
      return 'meeting-status-pill meeting-status-cancelled';
    }

    return 'meeting-status-pill meeting-status-draft';
  }

  function buildPageUrl(pageNumber) {
    const params = [];

    if (filterData.q) {
      params.push('q=' + encodeURIComponent(filterData.q));
    }

    if (filterData.status && filterData.status !== 'all') {
      params.push('status=' + encodeURIComponent(filterData.status));
    }

    if (filterData.sort && filterData.sort !== 'latest') {
      params.push('sort=' + encodeURIComponent(filterData.sort));
    }

    params.push('page=' + pageNumber);

    return '/meetings?' + params.join('&');
  }
%>

<style>
  /* ── Meetings List — pakai CSS variables tema, ikut dark/light otomatis ── */

  .meeting-page-shell {
    min-height: calc(100vh - 72px);
    background: var(--background);
    color: var(--foreground);
  }

  .meeting-page-shell * {
    box-sizing: border-box;
  }

  .meeting-page-content {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 18px 22px 30px;
  }

  /* ── Header ── */
  .meeting-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .meeting-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: var(--foreground);
  }

  .meeting-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .meeting-create-button {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 12px;
    padding: 0 15px;
    font-size: 12.5px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
    border: 1px solid #059669;
    background: #059669;
    color: #ffffff;
    box-shadow: 0 8px 20px color-mix(in srgb, #059669 25%, transparent);
  }

  .meeting-create-button:hover {
    background: #047857;
    border-color: #047857;
  }

  /* ── Filter ── */
  .meeting-filter-form {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .meeting-search-box {
    position: relative;
    flex: 1 1 300px;
    max-width: 380px;
  }

  .meeting-search-box > span {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12.5px;
    opacity: 0.85;
    pointer-events: none;
  }

  .meeting-search-box input,
  .meeting-filter-select {
    height: 42px;
    border-radius: 11px;
    border: 1.5px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    font-size: 12.5px;
    outline: none;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .meeting-search-box input {
    width: 100%;
    padding: 0 14px 0 42px;
  }

  .meeting-search-box input::placeholder {
    color: var(--muted-foreground);
  }

  .meeting-filter-select {
    min-width: 150px;
    padding: 0 13px;
    cursor: pointer;
  }

  .meeting-search-box input:focus,
  .meeting-filter-select:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 3px color-mix(in srgb, #10b981 18%, transparent);
  }

  .meeting-filter-submit {
    height: 42px;
    border: none;
    border-radius: 11px;
    padding: 0 15px;
    background: #059669;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 800;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s ease;
  }

  .meeting-filter-submit:hover {
    background: #047857;
  }

  /* ── Alert ── */
  .meeting-alert {
    margin-bottom: 18px;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, #ef4444 35%, transparent);
    background: color-mix(in srgb, #ef4444 10%, transparent);
    color: #ef4444;
    padding: 12px 16px;
    font-size: 12.5px;
    font-weight: 800;
  }

  /* ── List ── */
  .meeting-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Card ── */
  .meeting-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    min-height: 78px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--card);
    color: var(--card-foreground);
    padding: 11px 14px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .meeting-card:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--border) 60%, var(--foreground));
    background: color-mix(in srgb, var(--card) 95%, var(--foreground));
    box-shadow: 0 12px 24px color-mix(in srgb, var(--foreground) 7%, transparent);
  }

  .meeting-main-link {
    min-width: 0;
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr);
    align-items: center;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }

  /* ── Date box ── */
  .meeting-date-box {
    width: 54px;
    height: 54px;
    border-radius: 13px;
    background: color-mix(in srgb, #10b981 12%, transparent);
    color: #059669;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dark .meeting-date-box {
    color: #34d399;
  }

  .meeting-date-box.completed,
  .meeting-date-box.cancelled,
  .meeting-date-box.draft {
    background: color-mix(in srgb, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
  }

  .meeting-date-month {
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--muted-foreground);
  }

  .meeting-date-day {
    margin-top: 6px;
    font-size: 24px;
    line-height: 0.85;
    font-weight: 950;
    letter-spacing: -0.08em;
  }

  .meeting-info {
    min-width: 0;
  }

  .meeting-card-title {
    margin: 0;
    color: var(--card-foreground);
    font-size: 16.5px;
    line-height: 1.2;
    font-weight: 850;
    letter-spacing: -0.025em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meeting-main-link:hover .meeting-card-title {
    color: #10b981;
  }

  .meeting-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 15px;
    margin-top: 8px;
    color: var(--muted-foreground);
    font-size: 12.5px;
    font-weight: 600;
  }

  .meeting-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }

  /* ── Actions ── */
  .meeting-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ── Status pill ── */
  .meeting-status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 25px;
    padding: 0 12px;
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }

  .meeting-status-scheduled {
    background: color-mix(in srgb, #10b981 15%, transparent);
    color: #059669;
  }

  .dark .meeting-status-scheduled {
    color: #34d399;
  }

  .meeting-status-completed {
    background: color-mix(in srgb, var(--muted) 60%, transparent);
    color: var(--muted-foreground);
  }

  .meeting-status-cancelled {
    background: color-mix(in srgb, #ef4444 14%, transparent);
    color: #dc2626;
  }

  .dark .meeting-status-cancelled {
    color: #f87171;
  }

  .meeting-status-draft {
    background: color-mix(in srgb, #f59e0b 15%, transparent);
    color: #d97706;
  }

  .dark .meeting-status-draft {
    color: #fbbf24;
  }

  /* ── Empty state ── */
  .meeting-empty-state {
    border: 1.5px dashed color-mix(in srgb, var(--border) 80%, var(--foreground));
    border-radius: 16px;
    background: var(--card);
    padding: 36px 22px;
    text-align: center;
  }

  .meeting-empty-state h2 {
    margin: 0;
    font-size: 16.5px;
    font-weight: 900;
    color: var(--card-foreground);
  }

  .meeting-empty-state p {
    margin: 8px 0 0;
    color: var(--muted-foreground);
    font-size: 12.5px;
    font-weight: 600;
  }

  /* ── Pagination ── */
  .meeting-pagination {
    margin-top: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .meeting-pagination p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 12.5px;
    font-weight: 700;
  }

  .meeting-pagination-links {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .meeting-page-link {
    min-width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--card-foreground);
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 850;
    transition: all 0.15s;
    padding: 0 0.5rem;
  }

  .meeting-page-link.active {
    border-color: #059669;
    background: #059669;
    color: #ffffff;
  }

  .meeting-page-link:hover:not(.active) {
    background: color-mix(in srgb, var(--muted) 50%, transparent);
  }

  /* ── Responsive ── */
  @media (max-width: 1100px) {
    .meeting-card {
      grid-template-columns: 1fr;
    }

    .meeting-actions {
      justify-content: flex-start;
      padding-left: 68px;
    }
  }

  @media (max-width: 768px) {
    .meeting-page-content {
      padding: 20px 16px 32px;
    }

    .meeting-header-row {
      align-items: flex-start;
      flex-direction: column;
      margin-bottom: 20px;
    }

    .meeting-title {
      font-size: 24px;
    }

    .meeting-header-actions,
    .meeting-create-button,
    .meeting-search-box,
    .meeting-filter-select,
    .meeting-filter-submit {
      width: 100%;
      max-width: none;
    }

    .meeting-main-link {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 12px;
    }

    .meeting-card {
      padding: 16px;
    }

    .meeting-date-box {
      width: 52px;
      height: 52px;
    }

    .meeting-date-day {
      font-size: 24px;
    }

    .meeting-card-title {
      font-size: 17px;
    }

    .meeting-meta-row {
      font-size: 12.5px;
      gap: 7px 10px;
    }

    .meeting-actions {
      padding-left: 64px;
    }
  }

  @media (max-width: 520px) {
    .meeting-main-link {
      grid-template-columns: 1fr;
    }

    .meeting-actions {
      width: 100%;
      padding-left: 0;
      justify-content: flex-start;
    }
  }
</style>

<div class="meeting-page-shell">
  <div class="meeting-page-content">

    <div class="meeting-header-row">
      <h1 class="meeting-title">Daftar Meeting</h1>

      <div class="meeting-header-actions">
        <% if (typeof canCreateMeeting !== 'undefined' && canCreateMeeting) { %>
          <a href="/meetings/create" class="meeting-create-button">
            <span>+</span>
            <span>Buat Meeting</span>
          </a>
        <% } %>
      </div>
    </div>

    <% if (typeof accessMessage !== 'undefined' && accessMessage) { %>
      <div class="meeting-alert">
        <%= accessMessage %>
      </div>
    <% } %>

    <form action="/meetings" method="GET" class="meeting-filter-form">
      <div class="meeting-search-box">
        <span>🔍</span>
        <input
          type="text"
          name="q"
          value="<%= filterData.q || '' %>"
          placeholder="Cari meeting..."
        >
      </div>

      <select name="status" class="meeting-filter-select" onchange="this.form.submit()">
        <option value="all" <%= filterData.status === 'all' ? 'selected' : '' %>>Semua Status</option>
        <option value="draft" <%= filterData.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="scheduled" <%= filterData.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
        <option value="completed" <%= filterData.status === 'completed' ? 'selected' : '' %>>Completed</option>
        <option value="cancelled" <%= filterData.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
      </select>

      <select name="sort" class="meeting-filter-select" onchange="this.form.submit()">
        <option value="latest" <%= filterData.sort === 'latest' ? 'selected' : '' %>>Terbaru</option>
        <option value="oldest" <%= filterData.sort === 'oldest' ? 'selected' : '' %>>Terlama</option>
      </select>

      <button type="submit" class="meeting-filter-submit">Cari</button>
    </form>

    <div class="meeting-list">
      <% if (meetings && meetings.length > 0) { %>
        <% meetings.forEach(function(meeting) { %>
          <div class="meeting-card">
            <a href="/meetings/<%= meeting.id %>" class="meeting-main-link" aria-label="Buka detail <%= meeting.title %>">
              <div class="meeting-date-box <%= meeting.status %>">
                <div class="meeting-date-month"><%= getMonthName(meeting.meeting_date) %></div>
                <div class="meeting-date-day"><%= getDayNumber(meeting.meeting_date) %></div>
              </div>

              <div class="meeting-info">
                <h2 class="meeting-card-title"><%= meeting.title %></h2>

                <div class="meeting-meta-row">
                  <span class="meeting-meta-item">
                    <span>⏰</span>
                    <span><%= formatTime(meeting.start_time) %> – <%= formatTime(meeting.end_time) %></span>
                  </span>

                  <span class="meeting-meta-item">
                    <span><%= getMeetingTypeIcon(meeting.meeting_type) %></span>
                    <span><%= getMeetingTypeLabel(meeting.meeting_type) %></span>
                  </span>

                  <span class="meeting-meta-item">
                    <span>👥</span>
                    <span><%= meeting.participant_count || 0 %> orang</span>
                  </span>
                </div>
              </div>
            </a>

            <div class="meeting-actions">
              <span class="<%= getStatusPillClass(meeting.status) %>">
                <%= getStatusLabel(meeting.status) %>
              </span>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="meeting-empty-state">
          <h2>Meeting Tidak Ditemukan</h2>
          <p>Tidak ada meeting yang sesuai dengan akses akun, pencarian, atau filter yang dipilih.</p>
        </div>
      <% } %>
    </div>

    <% if (paginationData.totalPages > 1) { %>
      <div class="meeting-pagination">
        <p>
          Halaman <strong><%= paginationData.page %></strong> dari <strong><%= paginationData.totalPages %></strong>
        </p>

        <div class="meeting-pagination-links">
          <% if (paginationData.page > 1) { %>
            <a href="<%= buildPageUrl(paginationData.page - 1) %>" class="meeting-page-link">
              Sebelumnya
            </a>
          <% } %>

          <% for (let pageNumber = 1; pageNumber <= paginationData.totalPages; pageNumber++) { %>
            <a
              href="<%= buildPageUrl(pageNumber) %>"
              class="meeting-page-link <%= pageNumber === paginationData.page ? 'active' : '' %>"
            >
              <%= pageNumber %>
            </a>
          <% } %>

          <% if (paginationData.page < paginationData.totalPages) { %>
            <a href="<%= buildPageUrl(paginationData.page + 1) %>" class="meeting-page-link">
              Berikutnya
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>