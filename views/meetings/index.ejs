<%- include('../partials/header') %>

<%
  const filterData = typeof filters !== 'undefined' && filters ? filters : { q: '', status: 'all', sort: 'latest' };
  const paginationData = typeof pagination !== 'undefined' && pagination
    ? pagination
    : { page: 1, totalPages: 1, totalItems: 0, limit: 5 };

  function getDateObject(dateValue) {
    const date = new Date(dateValue);
    return isNaN(date.getTime()) ? null : date;
  }

  function getMonthName(dateValue) {
    const date = getDateObject(dateValue);
    if (!date) return '-';
    return date.toLocaleDateString('id-ID', { month: 'short' }).toUpperCase();
  }

  function getDayNumber(dateValue) {
    const date = getDateObject(dateValue);
    if (!date) return '-';
    return String(date.getDate()).padStart(2, '0');
  }

  function formatTime(timeValue) {
    if (!timeValue) return '-';
    return String(timeValue).substring(0, 5);
  }

  function getMeetingTypeLabel(type) {
    if (type === 'online') return 'Online';
    if (type === 'hybrid') return 'Hybrid';
    return 'Ruang Meeting';
  }

  function getMeetingTypeIcon(type) {
    if (type === 'online') return '🌐';
    if (type === 'hybrid') return '🔀';
    return '📍';
  }

  function getStatusLabel(status) {
    if (status === 'scheduled') return 'Scheduled';
    if (status === 'completed') return 'Completed';
    if (status === 'cancelled') return 'Cancelled';
    return 'Draft';
  }

  function getStatusPillClass(status) {
    if (status === 'scheduled') return 'meeting-status-pill meeting-status-scheduled';
    if (status === 'completed') return 'meeting-status-pill meeting-status-completed';
    if (status === 'cancelled') return 'meeting-status-pill meeting-status-cancelled';
    return 'meeting-status-pill meeting-status-draft';
  }

  function getDateBoxClass(status) {
    if (status === 'scheduled') return 'meeting-date-box meeting-date-scheduled';
    return 'meeting-date-box meeting-date-muted';
  }

  function buildPageUrl(pageNumber) {
    const params = [];
    if (filterData.q) params.push('q=' + encodeURIComponent(filterData.q));
    if (filterData.status && filterData.status !== 'all') params.push('status=' + encodeURIComponent(filterData.status));
    if (filterData.sort && filterData.sort !== 'latest') params.push('sort=' + encodeURIComponent(filterData.sort));
    params.push('page=' + pageNumber);
    return '/meetings?' + params.join('&');
  }
%>

<style>
  :root {
    --fml-emerald: #059669;
    --fml-emerald-soft: #ecfdf5;
    --fml-emerald-border: #a7f3d0;
    --fml-amber: #b45309;
    --fml-amber-soft: #fffbeb;
    --fml-amber-border: #fde68a;
    --fml-red: #dc2626;
    --fml-red-soft: #fef2f2;
    --fml-red-border: #fecaca;
    --fml-blue: #2563eb;
    --fml-blue-soft: #eff6ff;
    --fml-blue-border: #bfdbfe;
    --fml-shadow: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
    --fml-shadow-hover: 0 12px 24px -8px rgba(0,0,0,.12);
  }

  .dark {
    --fml-emerald: #34d399;
    --fml-emerald-soft: rgba(16,185,129,.12);
    --fml-emerald-border: rgba(52,211,153,.3);
    --fml-amber: #fbbf24;
    --fml-amber-soft: rgba(245,158,11,.14);
    --fml-amber-border: rgba(251,191,36,.3);
    --fml-red: #f87171;
    --fml-red-soft: rgba(239,68,68,.14);
    --fml-red-border: rgba(248,113,113,.3);
    --fml-blue: #60a5fa;
    --fml-blue-soft: rgba(59,130,246,.12);
    --fml-blue-border: rgba(96,165,250,.3);
    --fml-shadow: 0 1px 3px rgba(0,0,0,.3), 0 1px 2px rgba(0,0,0,.24);
    --fml-shadow-hover: 0 16px 28px -10px rgba(0,0,0,.5);
  }

  .meeting-page-shell {
    min-height: 100vh;
    background: var(--background);
    color: var(--foreground);
  }

  .meeting-page-shell * {
    box-sizing: border-box;
  }

  .meeting-page-content {
    width: min(100%, 1536px);
    margin-inline: auto;
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .meeting-page-content { padding: 1.5rem; }
  }

  @media (min-width: 1280px) {
    .meeting-page-content { padding: 2rem; }
  }

  .meeting-header-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }

  .meeting-title-group {
    min-width: 0;
  }

  .meeting-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(90deg, var(--fml-emerald), var(--foreground));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (min-width: 640px) {
    .meeting-title { font-size: 2.25rem; }
  }

  .meeting-subtitle {
    color: var(--muted-foreground);
    font-size: .875rem;
    font-weight: 500;
    margin: .375rem 0 0;
  }

  .meeting-create-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    height: 38px;
    padding: 0 1rem;
    border-radius: .75rem;
    flex-shrink: 0;
    background: var(--fml-emerald);
    color: #fff;
    text-decoration: none;
    font-size: .8rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 8px 18px -6px var(--fml-emerald);
    transition: transform .2s ease, opacity .2s ease;
  }

  .meeting-create-button:hover {
    opacity: .92;
    transform: translateY(-1px);
  }

  .meeting-filter-form {
    display: flex;
    align-items: center;
    gap: .75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .meeting-search-box {
    position: relative;
    flex: 1 1 300px;
    max-width: 420px;
  }

  .meeting-search-box > span {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: .8rem;
    opacity: .8;
    pointer-events: none;
  }

  .meeting-search-box input,
  .meeting-filter-select {
    height: 42px;
    border-radius: .75rem;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    font-size: .82rem;
    outline: none;
    font-family: inherit;
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .meeting-search-box input {
    width: 100%;
    padding: 0 1rem 0 2.75rem;
  }

  .meeting-search-box input::placeholder {
    color: var(--muted-foreground);
  }

  .meeting-filter-select {
    min-width: 155px;
    padding: 0 .9rem;
    cursor: pointer;
  }

  .meeting-search-box input:focus,
  .meeting-filter-select:focus {
    border-color: var(--fml-emerald);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--fml-emerald) 18%, transparent);
  }

  .meeting-filter-submit {
    height: 42px;
    border: none;
    border-radius: .75rem;
    padding: 0 1rem;
    background: var(--fml-emerald);
    color: #fff;
    font-size: .82rem;
    font-weight: 800;
    cursor: pointer;
    font-family: inherit;
    transition: transform .2s ease, opacity .2s ease;
  }

  .meeting-filter-submit:hover {
    opacity: .92;
    transform: translateY(-1px);
  }

  .meeting-alert {
    margin-bottom: 1rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--fml-red) 35%, transparent);
    background: color-mix(in srgb, var(--fml-red) 10%, transparent);
    color: var(--fml-red);
    padding: .8rem 1rem;
    font-size: .82rem;
    font-weight: 800;
  }

  .meeting-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .meeting-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 96px;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--card-foreground);
    box-shadow: var(--fml-shadow);
    padding: 1rem 1.25rem;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease, background-color .25s ease;
    text-decoration: none;
  }

  .meeting-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--fml-shadow-hover);
    border-color: var(--fml-emerald-border);
  }

  .meeting-date-box {
    width: 64px;
    height: 64px;
    border-radius: .9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid transparent;
  }

  .meeting-date-scheduled {
    background: var(--fml-emerald-soft);
    border-color: var(--fml-emerald-border);
    color: var(--fml-emerald);
  }

  .meeting-date-muted {
    background: var(--muted);
    border-color: var(--border);
    color: var(--muted-foreground);
  }

  .meeting-date-month {
    font-size: .7rem;
    line-height: 1;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--muted-foreground);
  }

  .meeting-date-day {
    margin-top: .35rem;
    font-size: 1.65rem;
    line-height: .9;
    font-weight: 950;
    letter-spacing: -0.08em;
  }

  .meeting-info {
    flex: 1;
    min-width: 0;
  }

  .meeting-card-title {
    margin: 0;
    color: var(--foreground);
    font-size: 1.05rem;
    line-height: 1.2;
    font-weight: 850;
    letter-spacing: -0.025em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .meeting-card:hover .meeting-card-title {
    color: var(--fml-emerald);
  }

  .meeting-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .45rem .7rem;
    margin-top: .65rem;
    color: var(--muted-foreground);
    font-size: .78rem;
    font-weight: 600;
  }

  .meeting-meta-item {
    display: inline-flex;
    align-items: center;
    gap: .38rem;
    border-radius: .55rem;
    background: var(--muted);
    padding: .25rem .55rem;
    line-height: 1.2;
  }

  .meeting-status-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 0 .8rem;
    border-radius: 999px;
    font-size: .76rem;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .meeting-status-scheduled {
    background: var(--fml-emerald-soft);
    border: 1px solid var(--fml-emerald-border);
    color: var(--fml-emerald);
  }

  .meeting-status-completed {
    background: var(--muted);
    border: 1px solid var(--border);
    color: var(--muted-foreground);
  }

  .meeting-status-cancelled {
    background: var(--fml-red-soft);
    border: 1px solid var(--fml-red-border);
    color: var(--fml-red);
  }

  .meeting-status-draft {
    background: var(--fml-amber-soft);
    border: 1px solid var(--fml-amber-border);
    color: var(--fml-amber);
  }

  .meeting-empty-state {
    border: 1px dashed var(--border);
    border-radius: 1rem;
    background: var(--card);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .meeting-empty-state h2 {
    margin: 0;
    font-size: 1rem;
    font-weight: 900;
    color: var(--foreground);
  }

  .meeting-empty-state p {
    margin: .5rem 0 0;
    color: var(--muted-foreground);
    font-size: .82rem;
    font-weight: 600;
  }

  .meeting-pagination {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .meeting-pagination p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: .82rem;
    font-weight: 700;
  }

  .meeting-pagination-links {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex-wrap: wrap;
  }

  .meeting-page-link {
    min-width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: .65rem;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--card-foreground);
    text-decoration: none;
    font-size: .8rem;
    font-weight: 850;
    transition: all .15s;
    padding: 0 .55rem;
  }

  .meeting-page-link.active {
    border-color: var(--fml-emerald);
    background: var(--fml-emerald);
    color: #fff;
  }

  .meeting-page-link:hover:not(.active) {
    background: var(--muted);
  }

  @media (max-width: 768px) {
    .meeting-header-row {
      align-items: flex-start;
      flex-direction: column;
    }

    .meeting-filter-form,
    .meeting-search-box,
    .meeting-filter-select,
    .meeting-filter-submit,
    .meeting-create-button {
      width: 100%;
      max-width: none;
    }

    .meeting-card {
      align-items: flex-start;
      padding: 1rem;
    }

    .meeting-status-pill {
      margin-left: auto;
    }
  }

  @media (max-width: 520px) {
    .meeting-card {
      display: grid;
      grid-template-columns: 58px minmax(0, 1fr);
    }

    .meeting-status-pill {
      grid-column: 2;
      width: max-content;
      margin-left: 0;
    }
  }
</style>

<div class="meeting-page-shell">
  <div class="meeting-page-content">

    <div class="meeting-header-row">
      <div class="meeting-title-group">
        <h1 class="meeting-title">Daftar Meeting</h1>
        <p class="meeting-subtitle">Kelola jadwal dan data meeting Anda.</p>
      </div>

      <% if (typeof canCreateMeeting !== 'undefined' && canCreateMeeting) { %>
        <a href="/meetings/create" class="meeting-create-button">
          <span>+</span>
          <span>Buat Meeting</span>
        </a>
      <% } %>
    </div>

    <% if (typeof accessMessage !== 'undefined' && accessMessage) { %>
      <div class="meeting-alert">
        <%= accessMessage %>
      </div>
    <% } %>

    <form action="/meetings" method="GET" class="meeting-filter-form">
      <div class="meeting-search-box">
        <span>🔍</span>
        <input
          type="text"
          name="q"
          value="<%= filterData.q || '' %>"
          placeholder="Cari meeting..."
        >
      </div>

      <select name="status" class="meeting-filter-select" onchange="this.form.submit()">
        <option value="all" <%= filterData.status === 'all' ? 'selected' : '' %>>Semua Status</option>
        <option value="draft" <%= filterData.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="scheduled" <%= filterData.status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
        <option value="completed" <%= filterData.status === 'completed' ? 'selected' : '' %>>Completed</option>
        <option value="cancelled" <%= filterData.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
      </select>

      <select name="sort" class="meeting-filter-select" onchange="this.form.submit()">
        <option value="latest" <%= filterData.sort === 'latest' ? 'selected' : '' %>>Terbaru</option>
        <option value="oldest" <%= filterData.sort === 'oldest' ? 'selected' : '' %>>Terlama</option>
      </select>

      <button type="submit" class="meeting-filter-submit">Cari</button>
    </form>

    <div class="meeting-list">
      <% if (meetings && meetings.length > 0) { %>
        <% meetings.forEach(function(meeting) { %>
          <a href="/meetings/<%= meeting.id %>" class="meeting-card" aria-label="Buka detail <%= meeting.title %>">
            <div class="<%= getDateBoxClass(meeting.status) %>">
              <div class="meeting-date-month"><%= getMonthName(meeting.meeting_date) %></div>
              <div class="meeting-date-day"><%= getDayNumber(meeting.meeting_date) %></div>
            </div>

            <div class="meeting-info">
              <h2 class="meeting-card-title"><%= meeting.title %></h2>

              <div class="meeting-meta-row">
                <span class="meeting-meta-item">
                  <span>⏰</span>
                  <span><%= formatTime(meeting.start_time) %> - <%= formatTime(meeting.end_time) %></span>
                </span>

                <span class="meeting-meta-item">
                  <span><%= getMeetingTypeIcon(meeting.meeting_type) %></span>
                  <span><%= getMeetingTypeLabel(meeting.meeting_type) %></span>
                </span>

                <span class="meeting-meta-item">
                  <span>👥</span>
                  <span><%= meeting.participant_count || 0 %> orang</span>
                </span>
              </div>
            </div>

            <span class="<%= getStatusPillClass(meeting.status) %>">
              <%= getStatusLabel(meeting.status) %>
            </span>
          </a>
        <% }) %>
      <% } else { %>
        <div class="meeting-empty-state">
          <h2>Meeting Tidak Ditemukan</h2>
          <p>Tidak ada meeting yang sesuai dengan akses akun, pencarian, atau filter yang dipilih.</p>
        </div>
      <% } %>
    </div>

    <% if (paginationData.totalPages > 1) { %>
      <div class="meeting-pagination">
        <p>
          Halaman <strong><%= paginationData.page %></strong> dari <strong><%= paginationData.totalPages %></strong>
        </p>

        <div class="meeting-pagination-links">
          <% if (paginationData.page > 1) { %>
            <a href="<%= buildPageUrl(paginationData.page - 1) %>" class="meeting-page-link">
              Sebelumnya
            </a>
          <% } %>

          <% for (let pageNumber = 1; pageNumber <= paginationData.totalPages; pageNumber++) { %>
            <a
              href="<%= buildPageUrl(pageNumber) %>"
              class="meeting-page-link <%= pageNumber === paginationData.page ? 'active' : '' %>"
            >
              <%= pageNumber %>
            </a>
          <% } %>

          <% if (paginationData.page < paginationData.totalPages) { %>
            <a href="<%= buildPageUrl(paginationData.page + 1) %>" class="meeting-page-link">
              Berikutnya
            </a>
          <% } %>
        </div>
      </div>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>
