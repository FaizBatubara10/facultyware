<%- include('../partials/header') %>

<%
  /*
    Helper kecil untuk merapikan tampilan data meeting.
    Helper ini hanya dipakai di file EJS ini.
  */

  function getDateObject(dateValue) {
    const date = new Date(dateValue);
    return isNaN(date.getTime()) ? null : date;
  }

  function getMonthName(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.toLocaleDateString('id-ID', {
      month: 'short'
    });
  }

  function getDayNumber(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '-';
    }

    return date.getDate();
  }

  function getMonthKey(dateValue) {
    const date = getDateObject(dateValue);

    if (!date) {
      return '';
    }

    const year = date.getFullYear();
    const month = String(date.getMonth() + 1).padStart(2, '0');

    return year + '-' + month;
  }

  function formatTime(timeValue) {
    if (!timeValue) {
      return '-';
    }

    return String(timeValue).substring(0, 5);
  }

  function getMeetingTypeLabel(type) {
    if (type === 'online') {
      return 'Online';
    }

    if (type === 'hybrid') {
      return 'Hybrid';
    }

    return 'Ruang Meeting';
  }

  function getStatusLabel(status) {
    if (status === 'scheduled') {
      return 'Scheduled';
    }

    if (status === 'completed') {
      return 'Completed';
    }

    if (status === 'cancelled') {
      return 'Cancelled';
    }

    return 'Draft';
  }
%>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
    align-items: center;
  }

  .filter-bar input,
  .filter-bar select {
    flex: 1;
    min-width: 180px;
  }

  .is-hidden-by-filter {
    display: none !important;
  }
</style>

<div class="text-zinc-900 dark:text-zinc-100">
  <div class="max-w-5xl mx-auto px-4 md:px-6 py-6">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-black tracking-tight text-zinc-950 dark:text-zinc-100">
          Daftar Meeting
        </h1>

        <p class="text-zinc-500 dark:text-zinc-400 text-sm mt-1">
          Kelola dan lihat seluruh jadwal rapat terdaftar.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/meetings/create"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-emerald-600 transition-colors shadow-sm"
        >
          <span>+</span>
          Buat Meeting
        </a>
      </div>
    </div>

    <div class="filter-bar">
      <div class="relative w-full lg:max-w-md">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-lg">
          🔍
        </span>

        <input
          type="text"
          id="meetingSearchInput"
          placeholder="Cari meeting..."
          class="w-full rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 py-3 pl-11 pr-4 text-sm text-zinc-700 dark:text-zinc-100 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900"
        >
      </div>

      <select
        id="meetingStatusFilter"
        class="rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-sm text-zinc-800 dark:text-zinc-100 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900"
      >
        <option value="all">Semua Status</option>
        <option value="draft">Draft</option>
        <option value="scheduled">Scheduled</option>
        <option value="completed">Completed</option>
        <option value="cancelled">Cancelled</option>
      </select>

      <select
        id="meetingMonthFilter"
        class="rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-4 py-3 text-sm text-zinc-800 dark:text-zinc-100 outline-none focus:border-emerald-600 focus:ring-2 focus:ring-emerald-100 dark:focus:ring-emerald-900"
      >
        <option value="all">Semua Bulan</option>
        <option value="this_month">Bulan Ini</option>
        <option value="next_month">Bulan Depan</option>
      </select>
    </div>

    <div id="meetingList" class="space-y-4">

      <% if (meetings && meetings.length > 0) { %>

        <% meetings.forEach(function(meeting) { %>
          <%
            const meetingMonth = getMonthKey(meeting.meeting_date);

            const searchText = `
              ${meeting.title || ''}
              ${meeting.description || ''}
              ${meeting.meeting_type || ''}
              ${meeting.status || ''}
              ${getStatusLabel(meeting.status)}
            `.toLowerCase();
          %>

          <div
            onclick="window.location.href='/meetings/<%= meeting.id %>'"
            class="meeting-card group cursor-pointer rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-emerald-200 dark:hover:border-emerald-700 hover:shadow-md"
            data-search="<%= searchText %>"
            data-status="<%= String(meeting.status || '').toLowerCase() %>"
            data-month="<%= meetingMonth %>"
          >
            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">

              <div class="flex items-start gap-5 min-w-0">

                <div class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-2xl
                  <%= meeting.status === 'completed' ? 'bg-zinc-100 dark:bg-zinc-800' : 'bg-emerald-50 dark:bg-emerald-950' %>"
                >
                  <div class="text-xs font-bold uppercase tracking-wide text-zinc-400">
                    <%= getMonthName(meeting.meeting_date) %>
                  </div>

                  <div class="text-3xl font-black leading-none
                    <%= meeting.status === 'completed' ? 'text-zinc-800 dark:text-zinc-200' : 'text-emerald-700 dark:text-emerald-300' %>"
                  >
                    <%= getDayNumber(meeting.meeting_date) %>
                  </div>
                </div>

                <div class="min-w-0 pt-1">
                  <h2 class="text-xl font-black text-zinc-950 dark:text-zinc-100 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors">
                    <%= meeting.title %>
                  </h2>

                  <div class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">

                    <span class="inline-flex items-center gap-1.5">
                      <span>⏰</span>
                      <%= formatTime(meeting.start_time) %> - <%= formatTime(meeting.end_time) %>
                    </span>

                    <span class="inline-flex items-center gap-1.5">
                      <span>📍</span>
                      <%= getMeetingTypeLabel(meeting.meeting_type) %>
                    </span>

                    <span class="inline-flex items-center gap-1.5">
                      <span>👥</span>
                      <%= meeting.participant_count || 0 %> orang
                    </span>

                    <span class="inline-flex items-center gap-1.5 capitalize">
                      <span>🏷️</span>
                      <%= meeting.meeting_type || '-' %>
                    </span>

                  </div>

                  <% if (meeting.description) { %>
                    <p class="mt-2 text-sm text-zinc-400 dark:text-zinc-500 line-clamp-1">
                      <%= meeting.description %>
                    </p>
                  <% } %>
                </div>

              </div>

              <div class="flex shrink-0 items-center gap-3 lg:justify-end">

                <% if (meeting.status === 'scheduled') { %>
                  <span class="rounded-full bg-emerald-50 dark:bg-emerald-950 px-4 py-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-300">
                    Scheduled
                  </span>
                <% } else if (meeting.status === 'completed') { %>
                  <span class="rounded-full bg-zinc-100 dark:bg-zinc-800 px-4 py-1.5 text-xs font-bold text-zinc-600 dark:text-zinc-300">
                    Completed
                  </span>
                <% } else if (meeting.status === 'cancelled') { %>
                  <span class="rounded-full bg-red-50 dark:bg-red-950 px-4 py-1.5 text-xs font-bold text-red-600 dark:text-red-300">
                    Cancelled
                  </span>
                <% } else { %>
                  <span class="rounded-full bg-amber-50 dark:bg-amber-950 px-4 py-1.5 text-xs font-bold text-amber-700 dark:text-amber-300">
                    Draft
                  </span>
                <% } %>

              </div>

            </div>
          </div>

        <% }) %>

      <% } else { %>

        <div class="rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-12 text-center shadow-sm">
          <p class="text-lg font-black text-zinc-700 dark:text-zinc-200">
            Belum Ada Meeting
          </p>

          <p class="mt-1 text-sm text-zinc-400 dark:text-zinc-500">
            Silakan buat jadwal meeting baru terlebih dahulu.
          </p>
        </div>

      <% } %>

      <div
        id="filterEmptyState"
        class="hidden rounded-2xl border border-dashed border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 p-12 text-center shadow-sm"
      >
        <p class="text-lg font-black text-zinc-700 dark:text-zinc-200">
          Meeting Tidak Ditemukan
        </p>

        <p class="mt-1 text-sm text-zinc-400 dark:text-zinc-500">
          Tidak ada meeting yang sesuai dengan pencarian atau filter yang dipilih.
        </p>
      </div>

    </div>

  </div>
</div>

<script>
  function getTargetMonthKey(monthOffset) {
    const today = new Date();

    const targetDate = new Date(
      today.getFullYear(),
      today.getMonth() + monthOffset,
      1
    );

    const year = targetDate.getFullYear();
    const month = String(targetDate.getMonth() + 1).padStart(2, '0');

    return year + '-' + month;
  }

  function applyMeetingFilters() {
    const searchInput = document.getElementById('meetingSearchInput');
    const statusFilter = document.getElementById('meetingStatusFilter');
    const monthFilter = document.getElementById('meetingMonthFilter');
    const meetingCards = document.querySelectorAll('.meeting-card');
    const filterEmptyState = document.getElementById('filterEmptyState');

    if (!searchInput || !statusFilter || !monthFilter) {
      return;
    }

    const searchKeyword = searchInput.value.trim().toLowerCase();
    const selectedStatus = statusFilter.value;
    const selectedMonth = monthFilter.value;

    let selectedMonthKey = null;

    if (selectedMonth === 'this_month') {
      selectedMonthKey = getTargetMonthKey(0);
    }

    if (selectedMonth === 'next_month') {
      selectedMonthKey = getTargetMonthKey(1);
    }

    let visibleMeetingCount = 0;

    meetingCards.forEach(function(card) {
      const cardSearchText = card.dataset.search || '';
      const cardStatus = card.dataset.status || '';
      const cardMonth = card.dataset.month || '';

      const isSearchMatch =
        searchKeyword === '' ||
        cardSearchText.includes(searchKeyword);

      const isStatusMatch =
        selectedStatus === 'all' ||
        cardStatus === selectedStatus;

      const isMonthMatch =
        selectedMonth === 'all' ||
        cardMonth === selectedMonthKey;

      const shouldShowCard =
        isSearchMatch &&
        isStatusMatch &&
        isMonthMatch;

      if (shouldShowCard) {
        card.classList.remove('is-hidden-by-filter');
        visibleMeetingCount++;
      } else {
        card.classList.add('is-hidden-by-filter');
      }
    });

    if (filterEmptyState) {
      const hasMeetingData = meetingCards.length > 0;
      const shouldShowEmptyState = hasMeetingData && visibleMeetingCount === 0;

      filterEmptyState.classList.toggle('hidden', !shouldShowEmptyState);
    }
  }

  function initializeMeetingFilters() {
    const searchInput = document.getElementById('meetingSearchInput');
    const statusFilter = document.getElementById('meetingStatusFilter');
    const monthFilter = document.getElementById('meetingMonthFilter');

    if (!searchInput || !statusFilter || !monthFilter) {
      return;
    }

    searchInput.addEventListener('input', applyMeetingFilters);
    statusFilter.addEventListener('change', applyMeetingFilters);
    monthFilter.addEventListener('change', applyMeetingFilters);

    applyMeetingFilters();
  }

  document.addEventListener('DOMContentLoaded', initializeMeetingFilters);
</script>

<%- include('../partials/footer') %>