<%- include('partials/header') %>

<div class="p-4 md:p-6 xl:p-8 bg-[#f8f7f4] min-h-screen text-zinc-900 font-sans">
  <div class="max-w-screen-2xl mx-auto">
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Dashboard</h1>
      </div>
      <div class="flex items-center gap-3">
        <a class="inline-flex items-center justify-center rounded-lg bg-white border border-gray-200 shadow-sm px-4 py-2 text-sm font-medium text-zinc-700 hover:bg-gray-50 transition-colors" href="/meetings">
          Semua Rapat
        </a>
        <a class="inline-flex items-center justify-center rounded-lg bg-[#3a7553] px-4 py-2 text-sm font-medium text-white hover:bg-[#2d5c41] transition-colors shadow-sm" href="/meetings/create">
          + Buat Meeting
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-36">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1">Meeting Bulan Ini</p>
        <h2 class="text-4xl font-black text-[#1b5e20]"><%= totalMeetingBulanIni || 0 %></h2>
      </div>
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-36">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1">Total Peserta</p>
        <h2 class="text-4xl font-black text-gray-900">0</h2>
      </div>
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-36">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1">Menunggu Konfirmasi</p>
        <h2 class="text-4xl font-black text-[#d84315]">0</h2>
      </div>
      <div class="bg-white border border-gray-100 rounded-2xl p-6 shadow-sm flex flex-col justify-between h-36">
        <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mb-1">Notulen Pending</p>
        <h2 class="text-4xl font-black text-[#b78103]">0</h2>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <div class="lg:col-span-2 flex flex-col gap-4">
        <div class="flex justify-between items-end mb-2">
          <h2 class="text-lg font-bold tracking-tight text-zinc-900">Meeting Mendatang</h2>
          <a class="text-xs font-medium text-gray-500 hover:text-gray-800 transition-colors" href="/meetings">Lihat semua &rarr;</a>
        </div>

        <div class="flex flex-col gap-4">
          <% if (typeof meetingMendatang !== 'undefined' && meetingMendatang.length > 0) { %>
            <% meetingMendatang.forEach(meeting => { %>
              <div class="bg-white border border-gray-100 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-4">
                  <div class="bg-[#e6f4ea] text-center rounded-xl py-2 px-4 min-w-[70px]">
                    <div class="text-[#1b5e20] text-[10px] font-bold uppercase tracking-widest"><%= new Date(meeting.meeting_date).toLocaleString('id-ID', { month: 'short' }) %></div>
                    <div class="text-2xl font-black text-[#1b5e20] mt-0.5"><%= new Date(meeting.meeting_date).getDate() %></div>
                  </div>
                  <div>
                    <h3 class="text-[15px] font-bold text-zinc-900"><%= meeting.title %></h3>
                    <p class="text-xs text-gray-500 mt-1"><%= meeting.start_time %> - <%= meeting.end_time %> | <%= meeting.meeting_type %></p>
                  </div>
                </div>
                <div class="px-3 py-1.5 rounded-full text-[10px] font-bold tracking-wide bg-[#e6f4ea] text-[#1b5e20]">Terjadwal</div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="bg-white border border-gray-100 rounded-2xl p-8 text-center text-gray-400">
              Belum ada meeting yang terjadwal.
            </div>
          <% } %>
        </div>
      </div>

      <div class="flex flex-col gap-6 mt-4 lg:mt-0">
        <div>
          <h2 class="text-lg font-bold tracking-tight text-zinc-900 mb-3">Ringkasan Kehadiran</h2>
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm flex flex-col items-center justify-center text-center">
            <div class="bg-gray-50 p-4 rounded-full mb-3 text-gray-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
            </div>
            <p class="text-xs font-medium text-gray-400">Data kehadiran akan terisi otomatis <br> setelah sistem diintegrasikan.</p>
          </div>
        </div>

        <div>
          <h2 class="text-lg font-bold tracking-tight text-zinc-900 mb-3">Notulen Terbaru</h2>
          <div class="bg-white border border-gray-100 rounded-2xl p-8 shadow-sm flex flex-col items-center justify-center text-center">
            <div class="bg-gray-50 p-4 rounded-full mb-3 text-gray-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <p class="text-xs font-medium text-gray-400">Notulen akan muncul di sini <br> secara otomatis dari sistem.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>