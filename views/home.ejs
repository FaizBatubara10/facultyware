<%- include('partials/header') %>
  <div class="p-4 md:p-6 xl:p-8 bg-[#0c0c0e] min-h-screen text-white">
    <div class="max-w-screen-2xl mx-auto">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">Dashboard</h1>
        </div>
        <div class="flex items-center gap-3">
          <a class="inline-flex items-center justify-center rounded-lg bg-zinc-800/80 border border-zinc-700/50 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 transition-colors" href="/meetings">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            Semua Rapat
          </a>
          <a class="inline-flex items-center justify-center rounded-lg bg-emerald-700 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-600 transition-colors" href="/meetings/create">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            + Buat Meeting
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        
        <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs flex flex-col justify-between h-36">
          <div>
            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">Meeting Bulan Ini</p>
            <h2 class="text-4xl font-black mt-2 text-zinc-900"><%= totalMeetingBulanIni %></h2>
          </div>
          <p class="text-xs text-emerald-600 font-semibold flex items-center gap-1">
            ↑ <span class="text-zinc-400 font-normal">Diambil dari database</span>
          </p>
        </div>
        
        <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs flex flex-col justify-between h-36">
          <div>
            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">Total Peserta</p>
            <h2 class="text-4xl font-black mt-2 text-zinc-900">0</h2>
          </div>
          <p class="text-xs text-zinc-400 font-normal">Menunggu modul peserta</p>
        </div>

        <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs flex flex-col justify-between h-36">
          <div>
            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">Menunggu Konfirmasi</p>
            <h2 class="text-4xl font-black mt-2 text-orange-500">0</h2>
          </div>
          <p class="text-xs text-zinc-400 font-normal">Menunggu modul undangan</p>
        </div>

        <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs flex flex-col justify-between h-36">
          <div>
            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-widest">Notulen Pending</p>
            <h2 class="text-4xl font-black mt-2 text-red-500">0</h2>
          </div>
          <p class="text-xs text-zinc-400 font-normal">Menunggu modul notulen</p>
        </div>

      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 flex flex-col gap-4">
          <div class="flex justify-between items-center mb-1">
            <h2 class="text-lg font-bold tracking-tight text-white/80">Meeting Mendatang</h2>
            <a class="text-xs text-zinc-400 hover:text-white transition-colors" href="/meetings">Lihat semua →</a>
          </div>

          <div class="flex flex-col gap-4">
            <% if (meetingMendatang && meetingMendatang.length > 0) { %>
              <% meetingMendatang.forEach(meeting => { %>
                
                <div class="bg-white rounded-2xl p-5 flex items-center justify-between shadow-xs text-zinc-900">
                  <div class="flex items-center gap-4 md:gap-6">
                    
                    <div class="bg-[#f0fdf4] text-center rounded-2xl py-2 px-4 min-w-[75px] border border-emerald-100/50">
                      <div class="text-[#16a34a] text-xs font-black uppercase tracking-widest">
                        <%= new Date(meeting.meeting_date).toLocaleString('id-ID', { month: 'short' }) %>
                      </div>
                      <div class="text-2xl font-black text-zinc-900 mt-0.5">
                        <%= new Date(meeting.meeting_date).getDate() %>
                      </div>
                    </div>

                    <div class="flex flex-col gap-1.5">
                      <h3 class="text-lg font-bold text-zinc-900 leading-snug"><%= meeting.title %></h3>
                      <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-zinc-500">
                        <div class="flex items-center gap-1">
                          <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                          <%= meeting.start_time.substring(0, 5) %> - <%= meeting.end_time.substring(0, 5) %>
                        </div>
                        <div class="flex items-center gap-1">
                          <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                          <span class="capitalize"><%= meeting.meeting_type %></span>
                        </div>
                      </div>
                    </div>

                  </div>

                  <div class="px-3 py-1.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-100">
                    Terjadwal
                  </div>
                </div>

              <% }) %>
            <% } else { %>
              <div class="bg-white rounded-2xl p-8 text-center text-zinc-400 font-medium shadow-xs border border-dashed border-zinc-200">
                Tidak ada jadwal meeting mendatang yang tercatat di database.
              </div>
            <% } %>
          </div>
        </div>

        <div class="flex flex-col gap-6">
          
          <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs">
            <h3 class="text-base font-bold text-zinc-900 mb-4 tracking-tight">Ringkasan Kehadiran</h3>
            
            <div class="flex flex-col items-center justify-center py-8 bg-zinc-50 rounded-xl border border-dashed border-zinc-200">
              <svg class="w-8 h-8 text-zinc-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
              <span class="text-sm text-zinc-400 font-medium text-center">Data kehadiran belum tersedia.</span>
            </div>
          </div>

          <div class="bg-white rounded-2xl p-6 text-zinc-900 shadow-xs">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-base font-bold text-zinc-900 tracking-tight">Notulen Terbaru</h3>
            </div>

            <div class="flex flex-col items-center justify-center py-6 bg-zinc-50 rounded-xl border border-dashed border-zinc-200">
              <svg class="w-8 h-8 text-zinc-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span class="text-sm text-zinc-400 font-medium text-center">Belum ada notulen yang diunggah.</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
<%- include('partials/footer') %>