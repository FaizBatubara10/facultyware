<%- include('../partials/header') %>

<style>
  
  :root{
    --fwd-emerald:#059669;  --fwd-emerald-soft:#ecfdf5;  --fwd-emerald-bd:#a7f3d0;
    --fwd-blue:#2563eb;     --fwd-blue-soft:#eff6ff;     --fwd-blue-bd:#bfdbfe;
    --fwd-amber:#b45309;    --fwd-amber-soft:#fffbeb;    --fwd-amber-bd:#fde68a;
    --fwd-red:#dc2626;      --fwd-red-soft:#fef2f2;      --fwd-red-bd:#fecaca;
    --fwd-violet:#7c3aed;   --fwd-violet-soft:#f5f3ff;   --fwd-violet-bd:#ddd6fe;
    --fwd-shadow:0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  }
  .dark{
    --fwd-emerald:#34d399;  --fwd-emerald-soft:rgba(16,185,129,.12);  --fwd-emerald-bd:rgba(52,211,153,.3);
    --fwd-blue:#60a5fa;     --fwd-blue-soft:rgba(59,130,246,.12);     --fwd-blue-bd:rgba(96,165,250,.3);
    --fwd-amber:#fbbf24;    --fwd-amber-soft:rgba(245,158,11,.14);    --fwd-amber-bd:rgba(251,191,36,.3);
    --fwd-red:#f87171;      --fwd-red-soft:rgba(239,68,68,.14);       --fwd-red-bd:rgba(248,113,113,.3);
    --fwd-violet:#a78bfa;   --fwd-violet-soft:rgba(139,92,246,.14);   --fwd-violet-bd:rgba(167,139,250,.3);
    --fwd-shadow:0 1px 3px rgba(0,0,0,.3), 0 1px 2px rgba(0,0,0,.24);
  }

  .fwd-wrap{ padding:1rem; min-height:100vh; color:var(--foreground); }
  @media(min-width:768px){ .fwd-wrap{ padding:1.5rem; } }
  @media(min-width:1280px){ .fwd-wrap{ padding:2rem; } }
  .fwd-inner{ max-width:48rem; margin-inline:auto; }

  .fwd-back-btn{
    display:inline-flex; align-items:center; gap:.5rem; margin-bottom:1.5rem;
    font-size:.875rem; font-weight:600; color:var(--muted-foreground); text-decoration:none; transition:color .2s ease;
  }
  .fwd-back-btn:hover{ color:var(--foreground); }
  .fwd-back-btn svg{ width:1rem; height:1rem; flex-shrink:0; }

  .fwd-alert{
    display:flex; align-items:center; gap:.75rem; padding:.875rem 1.125rem; border-radius:.875rem;
    margin-bottom:1.5rem; font-size:.875rem; font-weight:600;
  }
  .fwd-alert svg{ width:1.25rem; height:1.25rem; flex-shrink:0; }
  .fwd-alert-ok{ background:var(--fwd-emerald-soft); border:1px solid var(--fwd-emerald-bd); color:var(--fwd-emerald); }
  .fwd-alert-no{ background:var(--fwd-red-soft); border:1px solid var(--fwd-red-bd); color:var(--fwd-red); }

  .fwd-card{ border-radius:1rem; overflow:hidden; background:var(--card); border:1px solid var(--border); box-shadow:var(--fwd-shadow); }
  .fwd-card-section{ padding:1.5rem; border-bottom:1px solid var(--border); }
  .fwd-card-section:last-child{ border-bottom:none; }

  .fwd-pill{
    display:inline-flex; align-items:center; border:1px solid; font-size:.65rem; font-weight:800;
    text-transform:uppercase; letter-spacing:.08em; padding:.3rem .7rem; border-radius:9999px; margin-bottom:.75rem;
  }
  .fwd-pill-orange{ background:var(--fwd-amber-soft); color:var(--fwd-amber); border-color:var(--fwd-amber-bd); }
  .fwd-pill-emerald{ background:var(--fwd-emerald-soft); color:var(--fwd-emerald); border-color:var(--fwd-emerald-bd); }
  .fwd-pill-red{ background:var(--fwd-red-soft); color:var(--fwd-red); border-color:var(--fwd-red-bd); }
  .fwd-pill-blue{ background:var(--fwd-blue-soft); color:var(--fwd-blue); border-color:var(--fwd-blue-bd); }
  .fwd-pill-muted{ background:var(--muted); color:var(--muted-foreground); border-color:var(--border); }

  .fwd-detail-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .fwd-detail-title{ font-size:1.5rem; font-weight:800; color:var(--foreground); line-height:1.3; margin:0; }
  .fwd-detail-desc{ font-size:.875rem; color:var(--muted-foreground); margin:.5rem 0 0; line-height:1.6; }

  .fwd-date-box{
    flex-shrink:0; text-align:center; border-radius:1rem; padding:.75rem 1.25rem;
    background:var(--fwd-emerald-soft); border:1px solid var(--fwd-emerald-bd);
  }
  .fwd-date-month{ font-size:.7rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:var(--fwd-emerald); }
  .fwd-date-day{ font-size:1.875rem; font-weight:900; color:var(--foreground); margin-top:.125rem; }
  .fwd-date-year{ font-size:.65rem; font-weight:600; color:var(--muted-foreground); margin-top:.125rem; }

  .fwd-info-grid{ display:grid; grid-template-columns:1fr; gap:1.25rem; }
  @media(min-width:640px){ .fwd-info-grid{ grid-template-columns:1fr 1fr; } }
  .fwd-info-item{ display:flex; align-items:flex-start; gap:.75rem; }
  .fwd-info-item.fwd-span-2{ grid-column:1 / -1; }
  .fwd-info-icon{ width:2rem; height:2rem; border-radius:.625rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .fwd-info-icon svg{ width:1rem; height:1rem; }
  .fwd-info-label{ font-size:.65rem; font-weight:800; text-transform:uppercase; letter-spacing:.08em; color:var(--muted-foreground); margin:0; }
  .fwd-info-value{ font-size:.875rem; font-weight:700; color:var(--foreground); margin:.25rem 0 0; }
  .fwd-info-link{ display:inline-flex; align-items:center; gap:.25rem; font-size:.75rem; font-weight:600; color:var(--fwd-emerald); text-decoration:none; margin-top:.25rem; }
  .fwd-info-link:hover{ text-decoration:underline; }
  .fwd-info-link svg{ width:.75rem; height:.75rem; }

  .fwd-section-title{ font-size:.875rem; font-weight:800; color:var(--foreground); margin:0 0 1rem; }
  .fwd-section-title .fwd-count{ margin-left:.375rem; font-size:.75rem; font-weight:600; color:var(--muted-foreground); }

  .fwd-peserta-list{ display:flex; flex-direction:column; gap:.375rem; }
  .fwd-peserta-row{ display:flex; align-items:center; justify-content:space-between; gap:.75rem; padding:.625rem .75rem; border-radius:.75rem; transition:background-color .2s ease; }
  .fwd-peserta-row:hover{ background:var(--muted); }
  .fwd-peserta-left{ display:flex; align-items:center; gap:.75rem; min-width:0; }
  .fwd-peserta-avatar{
    width:2rem; height:2rem; border-radius:9999px; background:var(--muted); color:var(--muted-foreground);
    display:flex; align-items:center; justify-content:center; font-size:.7rem; font-weight:800; text-transform:uppercase; flex-shrink:0;
  }
  .fwd-peserta-name{ font-size:.875rem; font-weight:700; color:var(--foreground); margin:0; }
  .fwd-peserta-emp{ font-size:.72rem; color:var(--muted-foreground); margin:0; }
  .fwd-peserta-badge{ font-size:.65rem; font-weight:800; padding:.3rem .65rem; border-radius:9999px; flex-shrink:0; }

  .fwd-action-hint{ font-size:.75rem; font-weight:600; color:var(--muted-foreground); margin:0 0 1rem; }
  .fwd-action-row{ display:flex; flex-direction:column; gap:.75rem; }
  @media(min-width:640px){ .fwd-action-row{ flex-direction:row; } }
  .fwd-action-row form{ flex:1; }
  .fwd-btn{
    width:100%; display:inline-flex; align-items:center; justify-content:center; gap:.5rem;
    border-radius:.875rem; font-weight:700; font-size:.875rem; padding:.8rem 1.25rem; cursor:pointer;
    border:1px solid transparent; transition:background-color .2s ease, transform .2s ease;
  }
  .fwd-btn:hover{ transform:translateY(-1px); }
  .fwd-btn svg{ width:1rem; height:1rem; flex-shrink:0; }
  .fwd-btn-accept{ background:var(--fwd-emerald); color:#fff; }
  .fwd-btn-accept:hover{ opacity:.92; }
  .fwd-btn-decline{ background:var(--card); color:var(--fwd-red); border-color:var(--fwd-red-bd); }
  .fwd-btn-decline:hover{ background:var(--fwd-red-soft); }

  .fwd-status-note{ display:flex; align-items:center; gap:.5rem; font-size:.875rem; color:var(--muted-foreground); }
  .fwd-status-note svg{ width:1rem; height:1rem; flex-shrink:0; }
</style>

<div class="fwd-wrap">
  <div class="fwd-inner">

    <!-- Back -->
    <a href="/invitations/inbox" class="fwd-back-btn">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Kembali ke Kotak Masuk
    </a>

    <% if (typeof query !== 'undefined' && query.success) { %>
      <% const isConfirmed = query.success === 'confirmed'; %>
      <div class="fwd-alert <%= isConfirmed ? 'fwd-alert-ok' : 'fwd-alert-no' %>">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <% if (isConfirmed) { %>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          <% } else { %>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          <% } %>
        </svg>
        <span>
          <%= isConfirmed ? 'Anda telah mengkonfirmasi kehadiran untuk rapat ini.' : 'Anda telah menolak undangan rapat ini.' %>
        </span>
      </div>
    <% } %>

    <div class="fwd-card">

      <div class="fwd-card-section">
        <div class="fwd-detail-head">
          <div>
            <%
              const statusLabel = {
                invited: { text: 'Menunggu Konfirmasi', cls: 'fwd-pill-orange' },
                confirmed: { text: 'Dikonfirmasi', cls: 'fwd-pill-emerald' },
                declined: { text: 'Ditolak', cls: 'fwd-pill-red' },
                attended: { text: 'Hadir', cls: 'fwd-pill-blue' },
                absent: { text: 'Tidak Hadir', cls: 'fwd-pill-muted' },
              };
              const s = statusLabel[undangan.status] || statusLabel['invited'];
            %>
            <span class="fwd-pill <%= s.cls %>"><%= s.text %></span>
            <h1 class="fwd-detail-title"><%= undangan.title %></h1>
            <% if (undangan.description) { %>
              <p class="fwd-detail-desc"><%= undangan.description %></p>
            <% } %>
          </div>

          
          <div class="fwd-date-box">
            <div class="fwd-date-month"><%= new Date(undangan.meeting_date).toLocaleString('id-ID', { month: 'short' }) %></div>
            <div class="fwd-date-day"><%= new Date(undangan.meeting_date).getDate() %></div>
            <div class="fwd-date-year"><%= new Date(undangan.meeting_date).toLocaleString('id-ID', { year: 'numeric' }) %></div>
          </div>
        </div>
      </div>

      
      <div class="fwd-card-section fwd-info-grid">

        <div class="fwd-info-item">
          <div class="fwd-info-icon" style="background:var(--fwd-amber-soft); color:var(--fwd-amber);">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="fwd-info-label">Waktu</p>
            <p class="fwd-info-value"><%= undangan.start_time.substring(0, 5) %> – <%= undangan.end_time.substring(0, 5) %> WIB</p>
          </div>
        </div>

        <div class="fwd-info-item">
          <div class="fwd-info-icon" style="background:var(--fwd-blue-soft); color:var(--fwd-blue);">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <p class="fwd-info-label">Jenis Rapat</p>
            <p class="fwd-info-value" style="text-transform:capitalize;"><%= undangan.meeting_type %></p>
          </div>
        </div>

        <% if (undangan.meeting_type !== 'offline' && undangan.online_platform) { %>
          <div class="fwd-info-item fwd-span-2">
            <div class="fwd-info-icon" style="background:var(--fwd-violet-soft); color:var(--fwd-violet);">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.882v6.236a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
              </svg>
            </div>
            <div>
              <p class="fwd-info-label">Platform Online</p>
              <p class="fwd-info-value"><%= undangan.online_platform %></p>
              <% if (undangan.online_link) { %>
                <a href="<%= undangan.online_link %>" target="_blank" rel="noopener" class="fwd-info-link">
                  Buka Link
                  <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              <% } %>
            </div>
          </div>
        <% } %>

      </div>

      
      <div class="fwd-card-section">
        <h3 class="fwd-section-title">
          Peserta Rapat
          <span class="fwd-count">(<%= peserta.length %> orang)</span>
        </h3>
        <div class="fwd-peserta-list">
          <% peserta.forEach(p => { %>
            <%
              const ps = {
                invited: { text: 'Menunggu', cls: 'fwd-pill-orange' },
                confirmed: { text: 'Hadir', cls: 'fwd-pill-emerald' },
                declined: { text: 'Tolak', cls: 'fwd-pill-red' },
                attended: { text: 'Hadir', cls: 'fwd-pill-blue' },
                absent: { text: 'Absen', cls: 'fwd-pill-muted' },
              };
              const badge = ps[p.status] || ps['invited'];
            %>
            <div class="fwd-peserta-row">
              <div class="fwd-peserta-left">
                <div class="fwd-peserta-avatar"><%= p.name.substring(0, 2) %></div>
                <div>
                  <p class="fwd-peserta-name"><%= p.name %></p>
                  <% if (p.employee_number) { %>
                    <p class="fwd-peserta-emp"><%= p.employee_number %></p>
                  <% } %>
                </div>
              </div>
              <span class="fwd-peserta-badge <%= badge.cls %>"><%= badge.text %></span>
            </div>
          <% }) %>
        </div>
      </div>

      
<div class="fwd-card-section">
  <% 
    const meetingDateTime = new Date(undangan.meeting_date);
    const isPast = meetingDateTime < new Date();
  %>

  <% if (isPast && undangan.status === 'invited') { %>
    <div class="fwd-alert fwd-alert-no" style="margin-bottom:0;">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Rapat ini telah berlangsung. Waktu untuk merespons undangan telah berakhir.</span>
    </div>

  <% } else if (undangan.status === 'invited') { %>
    <p class="fwd-action-hint">Konfirmasi kehadiran Anda untuk rapat ini:</p>
    <div class="fwd-action-row">
      <form action="/invitations/<%= undangan.participant_id %>/status" method="POST">
        <input type="hidden" name="status" value="confirmed">
        <button type="submit" class="fwd-btn fwd-btn-accept">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Terima Undangan
        </button>
      </form>
      <form action="/invitations/<%= undangan.participant_id %>/status" method="POST">
        <input type="hidden" name="status" value="declined">
        <button type="submit" class="fwd-btn fwd-btn-decline">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Tolak Undangan
        </button>
      </form>
    </div>

  <% } else { %>
    <div class="fwd-status-note">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      Status undangan ini sudah diperbarui dan tidak dapat diubah lagi dari halaman ini.
    </div>
  <% } %>
</div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
