<%- include('../partials/header') %>

<div class="p-4 md:p-6 xl:p-8 min-h-screen">
  <div class="max-w-screen-2xl mx-auto">

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-white opacity-90">Kotak Masuk</h1>
        <p class="text-sm text-zinc-400 mt-1">Undangan rapat yang menunggu konfirmasi Anda</p>
      </div>
      <a href="/home"
        class="inline-flex items-center justify-center rounded-lg bg-zinc-800/80 border border-zinc-700/50 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-700 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Kembali ke Dashboard
      </a>
    </div>

    <% if (undangan && undangan.length > 0) { %>
      <div class="flex flex-col gap-4">
        <% undangan.forEach(item => { %>
          <a href="/invitations/<%= item.participant_id %>"
            class="bg-white rounded-2xl p-5 flex items-center justify-between shadow-xs text-zinc-900 hover:shadow-md hover:-translate-y-0.5 transition-all duration-150 group">

            <div class="flex items-center gap-4 md:gap-6">
              <!-- Tanggal -->
              <div class="bg-[#f0fdf4] text-center rounded-2xl py-2 px-4 min-w-[75px] border border-emerald-100/50 shrink-0">
                <div class="text-[#16a34a] text-xs font-black uppercase tracking-widest">
                  <%= new Date(item.meeting_date).toLocaleString('id-ID', { month: 'short' }) %>
                </div>
                <div class="text-2xl font-black text-zinc-900 mt-0.5">
                  <%= new Date(item.meeting_date).getDate() %>
                </div>
              </div>

              <!-- Info -->
              <div class="flex flex-col gap-1.5">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center gap-1 bg-orange-50 text-orange-600 border border-orange-100 text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded-full">
                    <span class="w-1.5 h-1.5 bg-orange-500 rounded-full inline-block animate-pulse"></span>
                    Menunggu Konfirmasi
                  </span>
                </div>
                <h3 class="text-base font-bold text-zinc-900 leading-snug group-hover:text-emerald-700 transition-colors">
                  <%= item.title %>
                </h3>
                <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-zinc-500">
                  <div class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <%= item.start_time.substring(0, 5) %> - <%= item.end_time.substring(0, 5) %>
                  </div>
                  <div class="flex items-center gap-1 capitalize">
                    <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <%= item.meeting_type %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Arrow -->
            <svg class="w-5 h-5 text-zinc-300 group-hover:text-emerald-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        <% }) %>
      </div>

    <% } else { %>
      <div class="bg-white rounded-2xl p-12 text-center shadow-xs border border-dashed border-zinc-200">
        <div class="flex flex-col items-center gap-3">
          <div class="w-14 h-14 bg-zinc-100 rounded-full flex items-center justify-center">
            <svg class="w-7 h-7 text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-zinc-400 font-medium text-sm">Tidak ada undangan yang menunggu konfirmasi.</p>
        </div>
      </div>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>
